<?xml version="1.0" encoding="utf-8"?>
<!-- Tonal gold pill background used by the empty-state Max hint. Sits at
     low saturation so the hint reads as a suggestion, not a CTA. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="999dp" />
    <solid android:color="#140F0700" />
    <stroke
        android:width="0.5dp"
        android:color="#3A2D00" />
</shape>
