<?xml version="1.0" encoding="utf-8"?>
<!-- Hero card: teal-to-near-black diagonal wash with a teal accent border.

     The card already carried the teal hairline to mark it as the centrepiece; the fill is
     that same idea carried through, so Richie's read is the one authored surface on the
     screen rather than another neutral panel. Matches iOS CheckInSheetView.heroBackground
     (brandTeal 0.22 -> 0.04, topLeading -> bottomTrailing); the two stops here are that
     teal composited over the app's near-black ground, since a shape drawable has no
     material to sit under. angle=315 is top-left -> bottom-right. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#082626"
        android:endColor="#0A0F0F" />
    <stroke android:width="1dp" android:color="#4D008B8B" />
    <corners android:radius="18dp" />
</shape>
