<?xml version="1.0" encoding="utf-8"?>
<!-- Family member row for the Plan tab's Membership section.
     Styled with the RichHealth design system (rh_ colors + settings-row rhythm),
     a lighter look than the Health Hub family card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="14dp"
        android:src="@drawable/ic_person"
        app:tint="@color/rh_accent"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/fm_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Family member"
                android:textColor="@color/rh_text_primary"
                android:textSize="15sp"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/fm_covered_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COVERED"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/rounded_category_bg"
                android:backgroundTint="#1A4CAF50"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/fm_pro_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRO"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/rounded_category_bg"
                android:backgroundTint="#1A008B8B"
                android:visibility="gone"/>
        </LinearLayout>

        <TextView
            android:id="@+id/fm_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Relation · email"
            android:textColor="@color/rh_text_tertiary"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/fm_action_button"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="Add to Pro"
        android:textSize="12sp"
        android:textAllCaps="false"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:textColor="@color/rh_accent"
        app:cornerRadius="10dp"
        app:strokeColor="@color/rh_divider"
        app:strokeWidth="1dp"
        app:backgroundTint="@android:color/transparent"/>
</LinearLayout>
