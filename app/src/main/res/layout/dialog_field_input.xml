<?xml version="1.0" encoding="utf-8"?>
<!-- Inline single-line input: quiet label + compact filled field. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="4dp"
    android:paddingVertical="5dp">

    <TextView
        android:id="@+id/input_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:maxWidth="150dp"
        android:textSize="14sp"
        android:textColor="@color/rh_text_secondary"/>

    <EditText
        android:id="@+id/field_input"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/bg_dialog_input"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:minHeight="36dp"
        android:gravity="center_vertical|end"
        android:maxLines="1"
        android:textSize="14sp"
        android:textColor="@color/rh_text_primary"
        android:textColorHint="@color/rh_text_tertiary"
        android:importantForAutofill="no"/>
</LinearLayout>
