<?xml version="1.0" encoding="utf-8"?>
<!-- FIRST onboarding step (2026-09): who is this account for?

     This used to be a SwitchMaterial buried at the bottom of the account step. It is
     asked here instead, before a single field of the signup is filled in, because the
     answer changes what the whole rest of onboarding is about — and because the
     guardian's address is verified against the server before this step can be left, at
     a point where nothing is invested yet and blocking costs the user nothing.

     Everything below the cards stays hidden (and unsent) unless "Someone else" is
     picked, so a person signing up for themselves sees exactly two cards and nothing
     more. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F0F">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- Same 80dp teal hero circle every other onboarding step uses. -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="#1A2E2E"
            app:cardCornerRadius="40dp"
            app:cardElevation="0dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_signup_family"
                app:tint="#008b8b" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Who are you creating this account for?"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:text="Every answer that follows describes the person this account belongs to"
            android:textColor="#888888"
            android:textSize="14sp" />

        <!-- Two cards, built in OnboardingCreatingForFragment with the shared
             SelectableCardAdapter so they look and behave like every other
             onboarding card grid. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_creating_for"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <!-- Revealed only by the "Someone else" card. -->
        <LinearLayout
            android:id="@+id/creating_for_other_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginBottom="20dp"
                android:background="#2C2C2C" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:text="Your own account"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="The email of YOUR RichHealth account — not the one you are creating. You need an account already; we check it before you can continue."
                android:textColor="#888888"
                android:textSize="13sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_parent_email"
                style="@style/CustomTextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:hint="Your email address">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_parent_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:textColor="#FFFFFF" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:text="This person is your…"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <!-- The value picked here is the NEW ACCOUNT's self-description towards you,
                 which is verbatim what the server stores as parentRelationship and what
                 its reciprocal map inverts to derive YOUR label. Creating an account for
                 your father → the new account IS your father → "Father". Never inverted
                 on the client. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Creating an account for your father? Pick Father. The label describes them, not you."
                android:textColor="#888888"
                android:textSize="13sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_parent_relationship"
                style="@style/CustomTextInputLayoutDropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Relationship">

                <AutoCompleteTextView
                    android:id="@+id/input_parent_relationship"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textColor="#FFFFFF" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Once the account is created we'll send you a request to confirm the link."
                android:textColor="#555555"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
