<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/activity_level_layout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:boxBackgroundColor="#262626"
        app:boxStrokeColor="#008b8b"
        app:hintTextColor="#008b8b">

        <AutoCompleteTextView
            android:id="@+id/activity_level_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Activity Level"
            android:inputType="none"
            android:textColor="@color/white"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/goal_layout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:boxBackgroundColor="#262626"
        app:boxStrokeColor="#008b8b"
        app:hintTextColor="#008b8b">

        <AutoCompleteTextView
            android:id="@+id/goal_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Primary Goal"
            android:inputType="none"
            android:textColor="@color/white"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/weekly_goal_layout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxBackgroundColor="#262626"
        app:boxStrokeColor="#008b8b"
        app:hintTextColor="#008b8b">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/weekly_goal_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Weekly Goal (kg)"
            android:inputType="numberDecimal"
            android:textColor="@color/white"/>
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>