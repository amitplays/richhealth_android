<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Food input -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter a food item"
            app:boxBackgroundColor="#1A1A1A"
            app:boxStrokeColor="#333333"
            app:hintTextColor="#808080"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/food_item_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:inputType="text"
                android:imeOptions="actionDone" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/check_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="Check"
            android:textAllCaps="false"
            app:backgroundTint="#008b8b"
            app:cornerRadius="10dp" />

        <ProgressBar
            android:id="@+id/check_progress"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:indeterminateTint="#008b8b"
            android:visibility="gone" />

        <!-- Result container -->
        <LinearLayout
            android:id="@+id/result_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:background="@drawable/rounded_category_bg"
            android:backgroundTint="#1A1A1A"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/recommendation_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/reason_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#CCCCCC"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginTop="8dp" />

            <!-- Feedback row: was this verdict helpful? -->
            <LinearLayout
                android:id="@+id/feedback_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Was this helpful?"
                    android:textColor="#808080"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/thumb_up"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="0dp"
                    app:icon="@drawable/ic_thumb_up"
                    app:iconSize="18dp"
                    app:iconTint="#808080"
                    app:iconPadding="0dp"
                    app:iconGravity="textStart"
                    android:contentDescription="Helpful" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/thumb_down"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="0dp"
                    app:icon="@drawable/ic_thumb_down"
                    app:iconSize="18dp"
                    app:iconTint="#808080"
                    app:iconPadding="0dp"
                    app:iconGravity="textStart"
                    android:contentDescription="Not helpful" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
