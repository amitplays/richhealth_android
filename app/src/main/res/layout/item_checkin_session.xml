<?xml version="1.0" encoding="utf-8"?>
<!-- Past-reads timeline entry: left dot + connecting line, then content. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <!-- Timeline gutter: vertical line spanning the row, dot near the top. -->
    <FrameLayout
        android:layout_width="20dp"
        android:layout_height="match_parent">

        <View
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_marginStart="3dp"
            android:background="#2A2A2A" />

        <View
            android:id="@+id/timeline_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/checkin_dot_bg"
            android:backgroundTint="#008b8b"
            android:contentDescription="@null" />
    </FrameLayout>

    <!-- Content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingBottom="18dp">

        <!-- when: period · date -->
        <TextView
            android:id="@+id/session_when"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#9E9E9E"
            android:textSize="12sp" />

        <!-- summary + status pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/session_summary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=""
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/status_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Action button: pending / in_progress only -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:layout_marginTop="8dp"
            app:backgroundTint="#008b8b"
            app:cornerRadius="8dp"
            android:visibility="gone" />

        <!-- Accordion header: "See what you shared" (completed w/ responses) -->
        <LinearLayout
            android:id="@+id/accordion_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:visibility="gone"
            android:layout_marginTop="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="See what you shared"
                android:textColor="#008b8b"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/accordion_chevron"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#008b8b"
                android:textSize="16sp"
                android:rotation="90"
                android:layout_marginStart="4dp"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- Accordion body: responses (GONE by default) -->
        <LinearLayout
            android:id="@+id/responses_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/checkin_watch_bg"
            android:padding="12dp"
            android:layout_marginTop="10dp"
            android:visibility="gone" />

    </LinearLayout>
</LinearLayout>
