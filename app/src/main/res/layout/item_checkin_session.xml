<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#1A1A1E"
    app:strokeColor="#2A2A2A"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Row 1: period badge + status badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/period_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Weekly"
                android:textColor="#008b8b"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/rounded_category_bg"
                android:backgroundTint="#0A2828"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pending"
                android:textColor="#808080"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Row 2: Date -->
        <TextView
            android:id="@+id/session_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Monday, Jan 1"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- Row 3: Sub-info (progress or missed message) -->
        <TextView
            android:id="@+id/session_sub_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="6 questions"
            android:textColor="#808080"
            android:textSize="12sp"
            android:layout_marginBottom="12dp" />

        <!-- Action button: visible for pending / in_progress only -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_action"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Start"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:backgroundTint="#008b8b"
            app:cornerRadius="8dp"
            android:visibility="gone" />

        <!-- Accordion header for completed sessions -->
        <LinearLayout
            android:id="@+id/accordion_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="View Responses"
                android:textColor="#008b8b"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/accordion_chevron"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#008b8b"
                android:textSize="18sp"
                android:rotation="90" />

        </LinearLayout>

        <!-- Accordion body: responses (GONE by default) -->
        <LinearLayout
            android:id="@+id/responses_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
