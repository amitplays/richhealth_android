<?xml version="1.0" encoding="utf-8"?>
<!-- Incoming family requests sheet. Request rows (item_request_card) are added in
     Java from the live /api/user/relationship/requests payload; this shell holds the
     header, the list container, an empty state and a loading spinner. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet_surface"
    android:paddingTop="10dp"
    android:paddingBottom="22dp">

    <!-- Grabber -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_dialog_input"
        android:alpha="0.5"/>

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Family Requests"
            android:textColor="@color/rh_text_primary"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="People inviting you to connect as family"
            android:textColor="@color/rh_text_tertiary"
            android:textSize="13sp"/>
    </LinearLayout>

    <!-- Loading -->
    <ProgressBar
        android:id="@+id/family_requests_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="12dp"
        android:indeterminateTint="@color/rh_accent"
        android:visibility="gone"/>

    <!-- Empty state -->
    <TextView
        android:id="@+id/family_requests_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="28dp"
        android:paddingBottom="20dp"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:text="No pending family requests."
        android:textColor="@color/rh_text_tertiary"
        android:textSize="14sp"
        android:visibility="gone"/>

    <!-- Request rows added in Java (item_request_card) -->
    <LinearLayout
        android:id="@+id/family_requests_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="14dp"/>
</LinearLayout>
