<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/black">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:background="@color/black">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Health Check-In"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />

        <TextView
            android:id="@+id/tier_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#008b8b"
            android:textSize="11sp"
            android:background="@drawable/rounded_category_bg"
            android:backgroundTint="#0A2828"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="28dp">

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- (0) ACTION ZONE                                                  -->
            <!-- ═══════════════════════════════════════════════════════════════ -->

            <!-- Loading state -->
            <LinearLayout
                android:id="@+id/list_loading_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingVertical="64dp"
                android:visibility="visible">

                <ImageView
                    android:id="@+id/list_loading_logo"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_launcher"
                    android:layout_marginBottom="16dp"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loading your check-ins..."
                    android:textColor="#808080"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- No access state -->
            <LinearLayout
                android:id="@+id/no_access_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="64dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_heart_check"
                    app:tint="#008b8b"
                    android:layout_marginBottom="16dp"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Health Check-In is available on all plans."
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your personalized check-in will be scheduled automatically."
                    android:textColor="#808080"
                    android:textSize="13sp"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Start banner: visible when isDue=true -->
            <LinearLayout
                android:id="@+id/start_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/checkin_loop_bg"
                android:padding="20dp"
                android:layout_marginBottom="4dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your check-in is ready"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your AI-powered questions are generated just for you based on your health profile."
                    android:textColor="#9E9E9E"
                    android:textSize="13sp"
                    android:layout_marginBottom="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_start_checkin"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Start Health Check-In"
                    android:textColor="@color/white"
                    app:backgroundTint="#008b8b"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <!-- Empty state: no history yet AND not due -->
            <LinearLayout
                android:id="@+id/empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="56dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_success"
                    app:tint="#008b8b"
                    android:layout_marginBottom="16dp"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No check-ins yet"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/empty_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your first check-in will appear here when it's ready."
                    android:textColor="#808080"
                    android:textSize="13sp"
                    android:gravity="center" />
            </LinearLayout>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- (1) HERO — "Richie's read on you"                                -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/richie_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/checkin_hero_bg"
                android:padding="17dp"
                android:layout_marginTop="12dp"
                android:visibility="gone">

                <!-- processing state -->
                <LinearLayout
                    android:id="@+id/richie_processing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/richie_processing_logo"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_launcher"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Richie is reviewing your check-in…"
                        android:textColor="#C7C9CE"
                        android:textSize="14sp"
                        android:layout_marginStart="11dp" />
                </LinearLayout>

                <!-- ready state -->
                <LinearLayout
                    android:id="@+id/richie_ready"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- urgent safety banner (top of hero); shown only when safety.urgent -->
                    <LinearLayout
                        android:id="@+id/richie_safety_banner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/checkin_safety_bg"
                        android:padding="12dp"
                        android:layout_marginBottom="14dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_warning"
                            app:tint="#E53935"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="Warning" />

                        <TextView
                            android:id="@+id/richie_safety_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text=""
                            android:textColor="#FFD5D5"
                            android:textSize="14sp"
                            android:lineSpacingExtra="2dp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- header row 1: logo + label (single line) + overall chip. The council
                         count moves to the "Read the Council" row, and the date to its own row
                         below, so the label/date never wrap into a cramped column. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/ic_launcher"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="RICHIE'S READ ON YOU"
                            android:textColor="#008b8b"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textAllCaps="true"
                            android:letterSpacing="0.08"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/richie_overall_chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textAllCaps="true"
                            android:letterSpacing="0.06"
                            android:paddingHorizontal="9dp"
                            android:paddingVertical="4dp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- header row 2: date on its own full-width row, single line -->
                    <TextView
                        android:id="@+id/richie_updated"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#9E9E9E"
                        android:textSize="12sp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:layout_marginBottom="12dp" />

                    <!-- headline: prominent single line above the analysis -->
                    <TextView
                        android:id="@+id/richie_headline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginBottom="8dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/richie_analysis_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#F1F2F3"
                        android:textSize="16sp"
                        android:lineSpacingExtra="4dp" />

                    <!-- The Council (collapsible) -->
                    <LinearLayout
                        android:id="@+id/richie_council_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="14dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/richie_council_header"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="?attr/selectableItemBackground"
                            android:paddingVertical="4dp">

                            <TextView
                                android:id="@+id/richie_council_label"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Read the Council"
                                android:textColor="#008b8b"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/richie_council_chevron"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="›"
                                android:textColor="#008b8b"
                                android:textSize="18sp"
                                android:rotation="90"
                                android:contentDescription="@null" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/richie_council_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="8dp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Richie's reasoning (free tier, collapsible) -->
                    <LinearLayout
                        android:id="@+id/richie_reasoning_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="14dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/richie_reasoning_header"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="?attr/selectableItemBackground"
                            android:paddingVertical="4dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Richie's reasoning"
                                android:textColor="#008b8b"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/richie_reasoning_chevron"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="›"
                                android:textColor="#008b8b"
                                android:textSize="18sp"
                                android:rotation="90"
                                android:contentDescription="@null" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/richie_reasoning_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#BBBBBB"
                            android:textSize="13sp"
                            android:lineSpacingExtra="2dp"
                            android:layout_marginTop="8dp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <!-- failed state -->
                <LinearLayout
                    android:id="@+id/richie_failed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Couldn't generate your read this time."
                        android:textColor="#C7C9CE"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/richie_retry_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Try again"
                        android:textColor="@color/white"
                        android:layout_marginTop="8dp"
                        app:backgroundTint="#008b8b"
                        app:cornerRadius="10dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- (2) FOCUS — "Focus this week"                                    -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/focus_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Focus this week"
                    android:textColor="#9E9E9E"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.12"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top"
                    android:background="@drawable/checkin_loop_bg"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="◎"
                        android:textColor="#008b8b"
                        android:textSize="17sp"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/focus_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/focus_why"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#C7C9CE"
                            android:textSize="13sp"
                            android:lineSpacingExtra="2dp"
                            android:layout_marginTop="2dp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- (3) WINS — "What's going well"                                   -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/wins_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="What's going well"
                    android:textColor="#9E9E9E"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.12"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:id="@+id/wins_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- (4) WHAT RICHIE'S WATCHING                                       -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/watchlist_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="What Richie's watching"
                    android:textColor="#9E9E9E"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.12"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:id="@+id/watchlist_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/checkin_watch_bg" />
            </LinearLayout>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- (5) SHARPEN YOUR CARE — "Worth logging"                          -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/sharpen_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Worth logging"
                    android:textColor="#9E9E9E"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.12"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:id="@+id/sharpen_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- (6) RHYTHM                                                       -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/rhythm_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rhythm"
                    android:textColor="#9E9E9E"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.12"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔥"
                        android:textSize="15sp"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/rhythm_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#C7C9CE"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:id="@+id/rhythm_spark"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="end|center_vertical" />
                </LinearLayout>
            </LinearLayout>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- (7) PAST READS                                                   -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/past_reads_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Past reads"
                    android:textColor="#9E9E9E"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.12"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="10dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/checkin_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
