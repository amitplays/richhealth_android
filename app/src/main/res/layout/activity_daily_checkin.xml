<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/black">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:background="@color/black">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Health Check-In"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />

        <TextView
            android:id="@+id/tier_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#008b8b"
            android:textSize="11sp"
            android:background="@drawable/rounded_category_bg"
            android:backgroundTint="#0A2828"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ═══ TOP SECTION: chart on black bg ═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:tag="section_icon"
                        android:src="@drawable/ic_heart_check"
                        app:tint="#008b8b"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your Check-In History"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Personalized health questions based on your profile"
                    android:textColor="#999999"
                    android:textSize="13sp"
                    android:layout_marginBottom="12dp" />

                <!-- ═══ STREAK + CONSISTENCY (built from session list) ═══ -->
                <LinearLayout
                    android:id="@+id/streak_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone">

                    <!-- Completion ring + streak count -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">

                        <!-- Completion ring (drawn programmatically into this container) -->
                        <FrameLayout
                            android:id="@+id/ring_container"
                            android:layout_width="72dp"
                            android:layout_height="72dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView
                                android:id="@+id/completion_summary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 answered · 0 missed"
                                android:textColor="@color/white"
                                android:textSize="14sp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginTop="6dp">

                                <TextView
                                    android:id="@+id/streak_flame"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="🔥"
                                    android:textSize="22sp"
                                    android:layout_marginEnd="8dp"
                                    android:contentDescription="@null" />

                                <TextView
                                    android:id="@+id/streak_number"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textColor="@color/white"
                                    android:textSize="26sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/streak_label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="check-in streak"
                                    android:textColor="#999999"
                                    android:textSize="13sp"
                                    android:layout_marginStart="6dp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Info affordance: explains what check-ins are for -->
                        <ImageButton
                            android:id="@+id/checkin_info_btn"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:padding="6dp"
                            android:src="@drawable/ic_info_outline"
                            android:background="@drawable/bg_circle_info_btn"
                            app:tint="#999999"
                            android:contentDescription="About check-ins" />
                    </LinearLayout>

                    <!-- Consistency grid — populated programmatically, oldest → newest -->
                    <LinearLayout
                        android:id="@+id/consistency_grid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp" />

                    <!-- Legend (color is paired with a label for accessibility) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/checkin_dot_bg"
                            android:backgroundTint="#008b8b" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Completed"
                            android:textColor="#999999"
                            android:textSize="11sp"
                            android:layout_marginStart="5dp" />

                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/checkin_dot_bg"
                            android:backgroundTint="#E53935"
                            android:layout_marginStart="14dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Missed"
                            android:textColor="#999999"
                            android:textSize="11sp"
                            android:layout_marginStart="5dp" />

                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/checkin_dot_bg"
                            android:backgroundTint="#FFA500"
                            android:layout_marginStart="14dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="In progress"
                            android:textColor="#999999"
                            android:textSize="11sp"
                            android:layout_marginStart="5dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ═══ WHAT RICHIE THINKS (server-generated check-in analysis) ═══ -->
                <LinearLayout
                    android:id="@+id/richie_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="What Richie thinks"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <!-- processing state -->
                    <LinearLayout
                        android:id="@+id/richie_processing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone">

                        <ProgressBar
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            style="?android:attr/progressBarStyleSmall"
                            android:indeterminateTint="#008b8b" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Richie is reviewing your check-in…"
                            android:textColor="#999999"
                            android:textSize="13sp"
                            android:layout_marginStart="10dp" />
                    </LinearLayout>

                    <!-- ready state -->
                    <LinearLayout
                        android:id="@+id/richie_ready"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RICHIE'S TAKE"
                            android:textColor="#008b8b"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textAllCaps="true" />

                        <TextView
                            android:id="@+id/richie_analysis_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:lineSpacingExtra="3dp"
                            android:layout_marginTop="4dp" />

                        <!-- The Council (collapsible) -->
                        <LinearLayout
                            android:id="@+id/richie_council_section"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="14dp"
                            android:visibility="gone">

                            <LinearLayout
                                android:id="@+id/richie_council_header"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:background="?attr/selectableItemBackground"
                                android:paddingVertical="4dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="COUNCIL"
                                    android:textColor="#008b8b"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:textAllCaps="true"
                                    android:background="@drawable/rounded_category_bg"
                                    android:backgroundTint="#0A2828"
                                    android:paddingHorizontal="8dp"
                                    android:paddingVertical="3dp" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="The Council"
                                    android:textColor="@color/white"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:layout_marginStart="8dp" />

                                <TextView
                                    android:id="@+id/richie_council_chevron"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="›"
                                    android:textColor="#999999"
                                    android:textSize="18sp"
                                    android:rotation="90"
                                    android:contentDescription="@null" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/richie_council_container"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginTop="8dp"
                                android:visibility="gone" />
                        </LinearLayout>

                        <!-- Richie's reasoning (free tier, collapsible) -->
                        <LinearLayout
                            android:id="@+id/richie_reasoning_section"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="14dp"
                            android:visibility="gone">

                            <LinearLayout
                                android:id="@+id/richie_reasoning_header"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:background="?attr/selectableItemBackground"
                                android:paddingVertical="4dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Richie's reasoning"
                                    android:textColor="@color/white"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/richie_reasoning_chevron"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="›"
                                    android:textColor="#999999"
                                    android:textSize="18sp"
                                    android:rotation="90"
                                    android:contentDescription="@null" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/richie_reasoning_text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#BBBBBB"
                                android:textSize="13sp"
                                android:lineSpacingExtra="2dp"
                                android:layout_marginTop="8dp"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- failed state -->
                    <LinearLayout
                        android:id="@+id/richie_failed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Couldn't generate an analysis this time."
                            android:textColor="#999999"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/richie_retry_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Try again"
                            android:textColor="@color/white"
                            android:layout_marginTop="8dp"
                            app:backgroundTint="#008b8b"
                            app:cornerRadius="10dp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- ═══ DARK CARD CONTAINER (rounded top) ═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/rounded_top_dark_bg"
                android:padding="16dp">

                <!-- Start banner: visible when isDue=true -->
                <LinearLayout
                    android:id="@+id/start_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/rounded_category_bg"
                    android:backgroundTint="#0A2828"
                    android:padding="20dp"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your check-in is ready"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your AI-powered questions are generated just for you based on your health profile."
                        android:textColor="#808080"
                        android:textSize="13sp"
                        android:layout_marginBottom="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_start_checkin"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Start Health Check-In"
                        android:textColor="@color/white"
                        app:backgroundTint="#008b8b"
                        app:cornerRadius="12dp" />

                </LinearLayout>

                <!-- Loading state -->
                <LinearLayout
                    android:id="@+id/list_loading_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingVertical="48dp"
                    android:visibility="visible">

                    <ImageView
                        android:id="@+id/list_loading_logo"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/ic_launcher"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Loading your check-ins..."
                        android:textColor="#808080"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- No access state -->
                <LinearLayout
                    android:id="@+id/no_access_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="48dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_heart_check"
                        app:tint="#008b8b"
                        android:layout_marginBottom="16dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Health Check-In is available on all plans."
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your personalized check-in will be scheduled automatically."
                        android:textColor="#808080"
                        android:textSize="13sp"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Empty state -->
                <LinearLayout
                    android:id="@+id/empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="48dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_success"
                        app:tint="#008b8b"
                        android:layout_marginBottom="16dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="You're all caught up!"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/empty_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your next check-in will appear here when it's ready."
                        android:textColor="#808080"
                        android:textSize="13sp"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Session list — nestedScrollingEnabled=false so it expands fully inside NestedScrollView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/checkin_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingBottom="16dp"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
