<?xml version="1.0" encoding="utf-8"?>
<!--
  Photo variant of Utils.ServiceCardView (Services redesign, iOS parity):
  full-bleed photo + teal→black translucent scrim, teal icon top-left,
  floating glass stat pill top-right (label / value / sub), big white title +
  subtitle pinned bottom-left. Same child ids as view_service_card.xml so all
  HomeFragment bindings (getPillView/getMetaView/getSubtitleView…) keep working.
  Chevron kept (gone) for API compatibility.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <FrameLayout
        android:id="@+id/service_card_photo_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/service_card_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/scrim_teal_black" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="18dp">

            <ImageView
                android:id="@+id/service_card_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                app:tint="#008B8B"
                android:contentDescription="@null" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/service_card_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/service_card_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#B8FFFFFF"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Floating glass stat pill: LABEL / value / sub -->
        <LinearLayout
            android:id="@+id/service_card_stat_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="14dp"
            android:orientation="vertical"
            android:gravity="end"
            android:background="@drawable/stat_pill_glass_bg"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/service_card_stat_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#99FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/service_card_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/service_card_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#99FFFFFF"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <ImageView
            android:id="@+id/service_card_chevron"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:contentDescription="@null" />
    </FrameLayout>
</merge>
