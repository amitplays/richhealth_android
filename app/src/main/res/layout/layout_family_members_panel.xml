<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A1A"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Family Members"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dependent_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0/2 dependents"
            android:textColor="#008b8b"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginEnd="6dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/family_pro_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0/5 covered"
            android:textColor="#FFD700"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/close_panel_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#008b8b"
            android:contentDescription="Close panel" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage family health relationships"
        android:textColor="#808080"
        android:textSize="13sp"
        android:paddingHorizontal="12dp"
        android:paddingTop="0dp"
        android:paddingBottom="8dp"
        android:layout_marginTop="-4dp" />

    <!-- Content -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_person"
                app:tint="#008b8b"
                android:alpha="0.4"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No family members connected"
                android:textColor="#808080"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add family members to share health information"
                android:textColor="#666666"
                android:textSize="12sp"
                android:textAlignment="center" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/family_relationships_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="4dp" />
    </FrameLayout>

    <!-- Bottom action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/add_dependent_button"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginBottom="6dp"
            android:text="Add Dependent"
            android:textSize="12sp"
            android:textColor="@color/white"
            app:icon="@drawable/ic_person"
            app:iconGravity="start"
            app:cornerRadius="8dp"
            app:backgroundTint="#008b8b" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/add_family_member_button"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:text="Connect Family Member"
            android:textSize="12sp"
            android:textAllCaps="true"
            app:icon="@drawable/ic_person"
            app:iconGravity="start"
            app:cornerRadius="8dp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            app:strokeColor="#008b8b"
            android:textColor="#008b8b" />
    </LinearLayout>
</LinearLayout>
