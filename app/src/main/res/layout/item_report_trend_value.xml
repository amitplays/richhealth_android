<?xml version="1.0" encoding="utf-8"?>
<!-- One historic value in the enlarged trend view. The value shown is what the
     lab printed; the per-report reference range sits under it because labs
     disagree with each other. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/value_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="310 pg/mL" />

        <TextView
            android:id="@+id/value_range"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#8A8A8A"
            android:visibility="gone"
            tools:text="Normal 200–900" />
    </LinearLayout>

    <TextView
        android:id="@+id/value_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#8A8A8A"
        tools:text="4 May 2026" />
</LinearLayout>
