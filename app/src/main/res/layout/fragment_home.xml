<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000">

    <ScrollView
        android:id="@+id/home_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ══════ HEALTH ADVISORY — full-width content card ══════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/daily_digest_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#0CFFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="@dimen/icon_sm"
                            android:layout_height="@dimen/icon_sm"
                            android:src="@drawable/ic_heart"
                            app:tint="#008b8b"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="Advisory" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Daily Briefing"
                            android:textColor="#008b8b"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/digest_status_chip"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:padding="1dp"
                            android:contentDescription="Advisory status"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/digest_status_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Reading your latest data…"
                        android:textColor="#AEB2B8"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp" />

                    <!-- Briefing carousel -->
                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/briefing_pager"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <LinearLayout
                            android:id="@+id/briefing_dots"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="start|center_vertical" />

                        <TextView
                            android:id="@+id/briefing_updated"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#5A6A6A"
                            android:textSize="10sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/digest_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#CCCCCC"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp"
                        android:maxLines="4"
                        android:ellipsize="end"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/digest_error_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Could not load"
                            android:textColor="#555555"
                            android:textSize="11sp" />
                        <TextView
                            android:id="@+id/digest_retry"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Retry"
                            android:textColor="#008b8b"
                            android:textSize="11sp"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                    <!-- Secondary chrome kept for Java bindings (not shown) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:orientation="vertical"
                        android:visibility="gone">
                        <TextView android:id="@+id/digest_date_label" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView android:id="@+id/digest_location_chip" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <LinearLayout android:id="@+id/digest_aqi_row" android:layout_width="wrap_content" android:layout_height="wrap_content">
                            <View android:id="@+id/digest_aqi_dot" android:layout_width="8dp" android:layout_height="8dp" />
                            <TextView android:id="@+id/digest_aqi_text" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!--
              ════════════════════ TOOLS CARD STANDARD ════════════════════
              This contract is now embodied by ONE reusable component:
                  Utils.ServiceCardView  +  res/layout/view_service_card.xml
              Every primary tool card below is a <Utils.ServiceCardView>. Do NOT
              hand-inline MaterialCardView rows any more — add/edit cards through
              the component so they stay consistent.

              LAYOUT  : MaterialCardView (corner 18dp, elevation 0, bg @color/rh_surface)
                        > horizontal row (padding 16dp, minHeight 84dp): the whole
                        card surface is the click target.
                        [ icon 30dp ] [ title + pill / subtitle / meta ] [ chevron ]
              ICON    : @dimen/icon_lg (30dp), tint @color/rh_accent.  → app:serviceIcon
              TITLE   : 15sp bold @color/rh_accent, maxLines 1.        → app:serviceTitle
              SUBTITLE: 12.5sp @color/rh_text_secondary.               → app:serviceSubtitle
              PILL    : top-right; set via setPill(StatusPill.Intent, text) / hidePill().
                        Colour ONLY via the shared StatusPill semantics.
              META    : 11.5sp @color/rh_text_tertiary "Updated/Checked X ago";
                        setDate(...) / hideDate().
              CHEVRON : @drawable/ic_arrow_forward_ios, 16dp; status-coloured via
                        setChevronStatus(NORMAL|ATTENTION|URGENT) — mirrors iOS
                        (NORMAL=tertiary, ATTENTION=warning, URGENT=danger).
              Componentised by Claude on 2026-08-09 (was hand-inlined 2026-08-03).
              ═══════════════════════════════════════════════════════════════
            -->

            <!-- ══════════════════════════════════════════════════════════════
                 TOOLS CARDS — every card below is ONE reusable Utils.ServiceCardView
                 (see view_service_card.xml). Order mirrors iOS: Health Insights,
                 Connect a Device, Daily Check-In, Daily Advisory, Air Quality,
                 Dietary Insights, NutriCheck, Health Feed. Runtime state (pill,
                 meta date, status-coloured chevron) is applied from HomeFragment.
                 ══════════════════════════════════════════════════════════════ -->

            <!-- ══════ Health Insights ══════ -->
            <Utils.ServiceCardView
                android:id="@+id/health_analysis_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:serviceIcon="@drawable/ic_stethoscope"
                app:serviceTitle="Health Insights"
                app:serviceSubtitle="AI analysis of your reports &amp; vitals" />

            <!-- ══════ Connect a Device ══════ -->
            <Utils.ServiceCardView
                android:id="@+id/watch_connect_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:serviceIcon="@drawable/ic_activity"
                app:serviceTitle="Connect a Device"
                app:serviceSubtitle="Sync steps, heart rate &amp; sleep" />

            <!-- ══════ Daily Check-In ══════ -->
            <Utils.ServiceCardView
                android:id="@+id/checkin_home_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:serviceIcon="@drawable/ic_heart_check"
                app:serviceTitle="Daily Check-In"
                app:serviceSubtitle="A quick daily wellness check" />

            <!-- ══════ Daily Advisory (digest text, split from Briefing carousel) ══════ -->
            <Utils.ServiceCardView
                android:id="@+id/daily_advisory_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:serviceIcon="@drawable/ic_heart_smile"
                app:serviceTitle="Daily Advisory"
                app:serviceSubtitle="Reading your latest data…" />

            <!-- ══════ Air Quality ══════ -->
            <Utils.ServiceCardView
                android:id="@+id/aqi_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:serviceIcon="@drawable/ic_air"
                app:serviceTitle="Air Quality"
                app:serviceSubtitle="Local air quality index" />

            <!-- ══════ Dietary Insights ══════ -->
            <Utils.ServiceCardView
                android:id="@+id/dietary_insights_card"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:serviceIcon="@drawable/ic_food"
                app:serviceTitle="Dietary Insights"
                app:serviceSubtitle="What foods to eat and avoid" />

            <!-- ══════ NutriCheck ══════ -->
            <Utils.ServiceCardView
                android:id="@+id/nutri_check_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:serviceIcon="@drawable/ic_food"
                app:serviceTitle="NutriCheck"
                app:serviceSubtitle="See if a food fits your health" />

            <!-- ══════ Health Feed (preview → Feed tab) ══════ -->
            <Utils.ServiceCardView
                android:id="@+id/feed_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:serviceIcon="@drawable/ic_feed"
                app:serviceTitle="Health Feed"
                app:serviceSubtitle="Latest health articles &amp; updates" />

            <!-- ══════ HEALTH SERVICES ══════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BETA"
                    android:textColor="#FFD700"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.14"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:background="@drawable/rounded_category_bg"
                    android:backgroundTint="#332B00"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Health Services"
                    android:textColor="#666666"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.14" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginBottom="24dp">

                <!-- Find a Doctor -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/doctor_connection_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#0CFFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:minHeight="104dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="@dimen/icon_sm"
                                android:layout_height="@dimen/icon_sm"
                                android:src="@drawable/ic_medical_consultation"
                                app:tint="#008b8b"
                                android:layout_marginEnd="10dp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Find a Doctor"
                                android:textColor="#008b8b"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:maxLines="1"
                                android:ellipsize="end" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Search and connect with doctors"
                            android:textColor="#AEB2B8"
                            android:textSize="12sp"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:id="@+id/link_doctor_button"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Wellness Chat -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/mental_health_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#0CFFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:minHeight="104dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="@dimen/icon_sm"
                                android:layout_height="@dimen/icon_sm"
                                android:src="@drawable/ic_chat"
                                app:tint="#008b8b"
                                android:layout_marginEnd="10dp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Wellness Chat"
                                android:textColor="#008b8b"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:maxLines="1"
                                android:ellipsize="end" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="A private space to talk — not saved"
                            android:textColor="#AEB2B8"
                            android:textSize="12sp"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:id="@+id/chat_secondary_info"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/mental_health_chat_button"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ══════ FITNESS ══════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fitness"
                android:textColor="#666666"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.14"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginBottom="24dp">

                <!-- Log Workout -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/start_workout_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#0CFFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:minHeight="104dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="@dimen/icon_sm"
                                android:layout_height="@dimen/icon_sm"
                                android:src="@drawable/ic_fitness"
                                app:tint="#008b8b"
                                android:layout_marginEnd="10dp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Log Workout"
                                android:textColor="#008b8b"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:maxLines="1"
                                android:ellipsize="end" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Track your training sessions"
                            android:textColor="#AEB2B8"
                            android:textSize="12sp"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Exercises -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/browse_exercises_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#0CFFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:minHeight="104dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="@dimen/icon_sm"
                                android:layout_height="@dimen/icon_sm"
                                android:src="@drawable/ic_exercise"
                                app:tint="#008b8b"
                                android:layout_marginEnd="10dp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Exercises"
                                android:textColor="#008b8b"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:maxLines="1"
                                android:ellipsize="end" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Browse the exercise library"
                            android:textColor="#AEB2B8"
                            android:textSize="12sp"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <View
                android:id="@+id/mini_player_spacer"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:visibility="gone" />

            <!-- ══════ HIDDEN COMPAT: removed cards' ids kept for Java bindings ══════ -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView android:id="@+id/welcome_text" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/health_score" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/weekly_progress" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/weight_progress" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/profile_completion_status" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/location_name" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/aqi_standard_link" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/health_feed_see_all" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/health_analysis_location" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/health_analysis_aqi" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/health_analysis_profile_percent" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <com.google.android.material.chip.Chip android:id="@+id/aqi_status_chip" style="@style/Widget.RH.StatusChip" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <Button android:id="@+id/analyze_health_button" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <Button android:id="@+id/view_usage_button" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/recommended_podcasts_recycler" android:layout_width="wrap_content" android:layout_height="wrap_content" />

                <!-- [PLAN-PILL-REVIEW] disabled for review (backend-driven, keep after review):
                <LinearLayout android:id="@+id/plan_pill" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                    <ImageView android:id="@+id/plan_pill_icon" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/plan_pill_text" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
                -->

                <LinearLayout android:id="@+id/usage_status_card" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
                    <ImageView android:id="@+id/usage_status_icon" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/usage_status_title" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <!-- [PLAN-PILL-REVIEW] removed (hardcoded/dead plan pill) -->
                    <TextView android:id="@+id/usage_context" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- Retired per-card badges. These lived inside the old hand-inlined
                     cards; after migration to ServiceCardView the pill/meta/chevron
                     carry status, but these ids are kept (0dp) so existing null-guarded
                     Java toggles remain valid without NPEs. -->
                <ImageView android:id="@+id/health_status_chip" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" android:contentDescription="@null" />
                <ImageView android:id="@+id/health_analysis_last_updated" android:layout_width="0dp" android:layout_height="0dp" android:src="@drawable/ic_warning_yellow" android:visibility="gone" android:contentDescription="@null" />
                <TextView android:id="@+id/checkin_start_button" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <ImageView android:id="@+id/nutri_stale_indicator" android:layout_width="0dp" android:layout_height="0dp" android:src="@drawable/ic_warning_yellow" android:visibility="gone" android:contentDescription="@null" />
                <TextView android:id="@+id/watch_connect_button" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <ImageView android:id="@+id/dietary_stale_indicator" android:layout_width="0dp" android:layout_height="0dp" android:src="@drawable/ic_warning_yellow" android:visibility="gone" android:contentDescription="@null" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Mini Media Player Bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mini_player_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="8dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone"
        app:cardCornerRadius="18dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#0CFFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <ImageView
                    android:layout_width="@dimen/icon_xs"
                    android:layout_height="@dimen/icon_xs"
                    android:src="@drawable/ic_podcast"
                    app:tint="#008b8b"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/mini_player_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Now Playing"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <ImageButton
                    android:id="@+id/mini_player_close"
                    android:layout_width="@dimen/icon_container_sm"
                    android:layout_height="@dimen/icon_container_sm"
                    android:src="@drawable/ic_close"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="8dp"
                    app:tint="#808080"
                    android:scaleType="centerInside" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/mini_player_play_pause"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_play"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="#008b8b"
                    android:scaleType="centerInside" />

                <SeekBar
                    android:id="@+id/mini_player_seekbar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:progressTint="#008b8b"
                    android:thumbTint="#008b8b"
                    android:progressBackgroundTint="#333333"
                    android:max="100" />

                <TextView
                    android:id="@+id/mini_player_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00 / 0:00"
                    android:textColor="#808080"
                    android:textSize="12sp"
                    android:minWidth="70dp"
                    android:gravity="end" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
