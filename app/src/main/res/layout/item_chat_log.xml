<?xml version="1.0" encoding="utf-8"?>
<!--
  Persisted "logged" confirmation box shown in the chat after a quick-log card is
  saved (server ChatMessage.type == "log"). Centered, subtle info pill so the user
  sees, on returning to the chat, that data was recorded.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center"
    android:paddingHorizontal="16dp"
    android:paddingVertical="6dp">

    <TextView
        android:id="@+id/log_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chat_log_pill"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:textColor="#9FC7C0"
        android:textSize="12sp"
        android:gravity="center"
        android:maxWidth="300dp" />
</LinearLayout>
