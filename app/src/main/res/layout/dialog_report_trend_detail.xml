<?xml version="1.0" encoding="utf-8"?>
<!-- The enlarged chart: same picture as the card, bigger, plus every value
     exactly as the lab printed it. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#141414">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/detail_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            tools:text="Vitamin B12" />

        <TextView
            android:id="@+id/detail_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#8A8A8A"
            android:layout_marginTop="2dp"
            tools:text="Vitamins · 3 results · normal 200–900 pg/mL" />

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/detail_chart"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/detail_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#AAAAAA"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/detail_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/detail_close"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Close"
            android:textColor="@color/white"
            android:layout_marginTop="20dp"
            app:backgroundTint="@color/rh_accent"
            app:cornerRadius="10dp" />
    </LinearLayout>
</ScrollView>
