<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F0F">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- REPLACED: 📏 emoji → weighing scale vector in teal circular container -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="40dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#1A2E2E">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_onboarding_body"
                app:tint="#008b8b" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Your body stats"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="32dp"
            android:text="Used to calculate your BMI, BMR and health baselines"
            android:textColor="#888888"
            android:textSize="14sp" />

        <!-- Height -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Height"
            android:textColor="#CCCCCC"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_height_display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="170 cm"
            android:textColor="#008b8b"
            android:textSize="24sp"
            android:textStyle="bold" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_height"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:stepSize="1"
            android:value="170"
            android:valueFrom="100"
            android:valueTo="250"
            app:haloColor="#1A008b8b"
            app:labelBehavior="gone"
            app:thumbColor="#008b8b"
            app:thumbRadius="10dp"
            app:trackColorActive="#008b8b"
            app:trackColorInactive="#2A2A2A"
            app:trackHeight="4dp" />

        <!-- Weight -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Weight"
            android:textColor="#CCCCCC"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_weight_display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="70 kg"
            android:textColor="#008b8b"
            android:textSize="24sp"
            android:textStyle="bold" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_weight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:stepSize="1"
            android:value="70"
            android:valueFrom="30"
            android:valueTo="200"
            app:haloColor="#1A008b8b"
            app:labelBehavior="gone"
            app:thumbColor="#008b8b"
            app:thumbRadius="10dp"
            app:trackColorActive="#008b8b"
            app:trackColorInactive="#2A2A2A"
            app:trackHeight="4dp" />

        <!-- Waist (optional) — strongest self-report predictor of metabolic risk -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Waist size (optional)"
            android:textColor="#CCCCCC"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Measured around your belly button. Helps us predict metabolic and diabetes risk more accurately."
            android:textColor="#888888"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_waist_display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="80 cm"
            android:textColor="#008b8b"
            android:textSize="24sp"
            android:textStyle="bold" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_waist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1"
            android:value="80"
            android:valueFrom="40"
            android:valueTo="200"
            app:haloColor="#1A008b8b"
            app:labelBehavior="gone"
            app:thumbColor="#008b8b"
            app:thumbRadius="10dp"
            app:trackColorActive="#008b8b"
            app:trackColorInactive="#2A2A2A"
            app:trackHeight="4dp" />

        <CheckBox
            android:id="@+id/cb_waist_unknown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:buttonTint="#008b8b"
            android:text="I don't know my waist size"
            android:textColor="#AAAAAA"
            android:textSize="14sp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
