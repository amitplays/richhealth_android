<?xml version="1.0" encoding="utf-8"?>
<!-- Thin list row (profile-style), no card. Title + time on one line,
     a quiet one-line preview under it, hairline divider below. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/selectableItemBackground"
    android:paddingStart="16dp"
    android:paddingEnd="10dp"
    android:paddingTop="11dp"
    android:paddingBottom="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/session_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Chat Session Title"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/session_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3h ago"
            android:textColor="#008b8b"
            android:textSize="11sp"
            android:layout_marginStart="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/delete_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="2dp"
            app:icon="@drawable/ic_delete"
            app:iconSize="16dp"
            app:iconTint="#6E6E6E"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            app:backgroundTint="@android:color/transparent"
            app:rippleColor="#30FF5252"/>
    </LinearLayout>

    <TextView
        android:id="@+id/session_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Last message preview"
        android:textColor="#808080"
        android:textSize="12sp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="24dp"
        android:maxLines="1"
        android:ellipsize="end"/>

    <!-- Inset hairline divider between rows (profile-style) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="11dp"
        android:background="#2C2C2C"/>

    <!-- Hidden open_button for Java compatibility -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/open_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"/>
</LinearLayout>
