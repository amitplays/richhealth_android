<?xml version="1.0" encoding="utf-8"?>
<!-- Lean list row (profile/chat-history style), no card.
     Name + status + delete on one line, type/sharing/CTAs under it,
     hairline divider below. IDs preserved for UploadedFilesAdapter binding. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/selectableItemBackground"
    android:paddingStart="16dp"
    android:paddingEnd="10dp"
    android:paddingTop="11dp"
    android:paddingBottom="0dp">

    <!-- Row 1: name + status + delete -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/file_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Report Name"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/report_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Processing..."
            android:textColor="#008b8b"
            android:textSize="11sp"
            android:textStyle="italic"
            android:visibility="gone"
            android:layout_marginStart="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/delete_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="2dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:icon="@drawable/ic_delete"
            app:iconTint="#FF5252"
            app:iconSize="16dp"
            app:iconPadding="0dp"
            app:iconGravity="textStart"
            app:backgroundTint="@android:color/transparent"
            app:rippleColor="#30FF5252"
            app:cornerRadius="15dp" />
    </LinearLayout>

    <!-- Row 2: type + sharing + view + analyze -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/report_type"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Blood Test"
            android:textColor="#008b8b"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <ImageView
            android:id="@+id/sharing_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:padding="2dp"
            android:src="@drawable/ic_visibility_off"
            app:tint="#666666"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Sharing status"
            android:layout_marginEnd="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/view_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:text="View"
            android:textSize="12sp"
            android:textColor="#008b8b"
            app:icon="@drawable/ic_visibility"
            app:iconTint="#008b8b"
            app:iconSize="14dp"
            app:iconPadding="3dp"
            app:iconGravity="textStart"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/analyze_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:text="Analyze"
            android:textSize="12sp"
            android:textColor="#008b8b"
            app:icon="@drawable/ic_analytics_outline"
            app:iconTint="#008b8b"
            app:iconSize="14dp"
            app:iconPadding="3dp"
            app:iconGravity="textStart"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="8dp" />
    </LinearLayout>

    <!-- Inset hairline divider between rows (profile-style) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="11dp"
        android:background="#2C2C2C" />
</LinearLayout>
