<?xml version="1.0" encoding="utf-8"?>
<!-- Report trends bottom sheet: a swipeable carousel of one chart per test.
     Data comes finished from GET /api/health/reports/trends — the app groups
     nothing and converts nothing. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet_surface"
    android:paddingTop="10dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="#3A3A3A" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Report Trends"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:paddingStart="20dp"
        android:paddingEnd="20dp" />

    <TextView
        android:id="@+id/trends_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#8A8A8A"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:layout_marginTop="2dp"
        tools:text="4 tests from 3 reports" />

    <ProgressBar
        android:id="@+id/trends_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="40dp"
        android:indeterminateTint="@color/rh_accent" />

    <TextView
        android:id="@+id/trends_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#8A8A8A"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone"
        tools:text="Upload a report with test results and its values appear here." />

    <!-- Carousel. RecyclerView + PagerSnapHelper rather than ViewPager2 — the
         same idiom ProUpgradeDialog already uses, and no extra dependency. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/trends_carousel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

</LinearLayout>
