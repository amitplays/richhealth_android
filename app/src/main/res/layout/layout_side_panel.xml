<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tools_side_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#222222"
    android:orientation="vertical">

    <!-- Side Panel Header with Status Pill -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:background="#1A1A1A">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/status_pill">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RichHealth Podcast Pro"
                android:textColor="#008b8b"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unlock exclusive health podcasts"
                android:textColor="#B3FFFFFF"
                android:textSize="14sp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Status Pill - Dynamic pro status indicator -->
        <TextView
            android:id="@+id/status_pill"
            style="@style/Widget.RH.StatusPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/pill_status_premium"
            android:textColor="#000000"
            android:text="PRO"/>
    </RelativeLayout>

    <!-- Pro Features List -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Custom Podcast Feature -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/custom_podcast_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#2A2A2A">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:src="@drawable/ic_podcast_add"
                            app:tint="#008b8b"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Custom Podcast"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginStart="12dp"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Request a podcast on any health or fitness topic, tailored to your specific needs and interests."
                        android:textColor="#B3FFFFFF"
                        android:textSize="14sp"
                        android:layout_marginBottom="12dp"/>

                    <Button
                        android:id="@+id/request_podcast_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Request Custom Podcast"
                        android:textColor="@color/white"
                        app:backgroundTint="#008b8b"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Premium Podcasts Feature -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#2A2A2A">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:src="@drawable/ic_next"
                            app:tint="#008b8b"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Premium Podcasts"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginStart="12dp"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Access our exclusive library of premium health and fitness podcasts with in-depth research and expert analysis."
                        android:textColor="#B3FFFFFF"
                        android:textSize="14sp"
                        android:layout_marginBottom="12dp"/>

                    <Button
                        android:id="@+id/browse_premium_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Browse Premium Podcasts"
                        android:textColor="@color/white"
                        app:backgroundTint="#008b8b"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Advanced Podcast Controls -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#2A2A2A">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:src="@drawable/ic_speed"
                            app:tint="#008b8b"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Advanced Features"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginStart="12dp"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Enjoy advanced podcast features like offline listening, bookmark important segments, and personalized recommendations."
                        android:textColor="#B3FFFFFF"
                        android:textSize="14sp"
                        android:layout_marginBottom="12dp"/>

                    <Button
                        android:id="@+id/explore_features_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Explore Advanced Features"
                        android:textColor="@color/white"
                        app:backgroundTint="#008b8b"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/upgrade_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Upgrade to Pro"
        android:textColor="@color/white"
        android:textStyle="normal"
        android:textSize="12sp"
        android:padding="10dp"
        android:layout_margin="8dp"
        android:background="@drawable/pro_pill_background"/>
</LinearLayout>