<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/info_dialog_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        app:cardBackgroundColor="#1A1A1A"
        app:cardCornerRadius="20dp"
        app:cardElevation="10dp"
        app:strokeWidth="1dp"
        app:strokeColor="#1A008b8b">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <!-- Header: spinning logo + title + feature icon -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_card_icon_teal">

                    <ImageView
                        android:id="@+id/info_dialog_logo"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        app:tint="#008b8b"
                        android:contentDescription="Feature icon" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/info_dialog_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/info_dialog_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#008b8b"
                        android:textSize="11sp"
                        android:textAllCaps="true"
                        android:letterSpacing="0.10"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="#242424"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="14dp" />

            <!-- Body -->
            <TextView
                android:id="@+id/info_dialog_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#C0C0C0"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />

            <!-- Bullet list of "what you can do" -->
            <LinearLayout
                android:id="@+id/info_dialog_bullets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="14dp" />

            <!-- Encryption footer -->

            <!-- CTA -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/info_dialog_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Got it"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="14sp"
                android:letterSpacing="0.02"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginTop="18dp"
                app:backgroundTint="#008b8b"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.core.widget.NestedScrollView>
