<?xml version="1.0" encoding="utf-8"?>
<!-- Lean list row (profile/chat-history style), no card. Every id is preserved for
     HealthDataFragment.RelationshipAdapter — do not rename or remove:
     status_icon, name_text, status_chip, edit_button, remove_button, cancel_request_button,
     relationship_text, pro_badge, covered_badge, email_text, action_buttons_container,
     add_to_pro_button, remove_from_pro_button, main_actions_row, status_text. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/selectableItemBackground"
    android:paddingStart="16dp"
    android:paddingEnd="10dp"
    android:paddingTop="11dp"
    android:paddingBottom="0dp">

    <!-- Row 1: status icon + name + status chip + action icons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/status_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_person"
            app:tint="#008b8b"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/name_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Family Member Name"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <com.google.android.material.chip.Chip
            android:id="@+id/status_chip"
            style="@style/Widget.RH.StatusChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="CONNECTED"
            app:chipBackgroundColor="#4CAF50" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/edit_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="2dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:icon="@drawable/ic_edit"
            app:iconTint="#008b8b"
            app:iconSize="16dp"
            app:iconPadding="0dp"
            app:iconGravity="textStart"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="15dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/remove_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="2dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:icon="@drawable/ic_delete"
            app:iconTint="#FF5252"
            app:iconSize="16dp"
            app:iconPadding="0dp"
            app:iconGravity="textStart"
            app:backgroundTint="@android:color/transparent"
            app:rippleColor="#30FF5252"
            app:cornerRadius="15dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancel_request_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="2dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:icon="@drawable/ic_close"
            app:iconTint="#FF5252"
            app:iconSize="16dp"
            app:iconPadding="0dp"
            app:iconGravity="textStart"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="15dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Row 2: relationship + PRO / COVERED badges (subtitle, aligned under the name) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="30dp"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/relationship_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Father"
            android:textColor="#008b8b"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/pro_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PRO"
            android:textColor="#FFD700"
            android:textSize="9sp"
            android:textStyle="bold"
            android:paddingHorizontal="5dp"
            android:paddingVertical="1dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/gradient_border_bg"
            android:visibility="gone" />

        <TextView
            android:id="@+id/covered_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="COVERED"
            android:textColor="#4CAF50"
            android:textSize="9sp"
            android:textStyle="bold"
            android:paddingHorizontal="5dp"
            android:paddingVertical="1dp"
            android:layout_marginStart="4dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Row 3: email (quiet subtitle). Hidden by the adapter for dependents. -->
    <TextView
        android:id="@+id/email_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="family@example.com"
        android:textColor="#808080"
        android:textSize="12sp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="8dp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Pro plan action (family plan owners only; adapter shows exactly one, right-aligned).
         Compact text buttons to match the lean row aesthetic. -->
    <LinearLayout
        android:id="@+id/action_buttons_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginStart="30dp"
        android:layout_marginTop="4dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/add_to_pro_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:text="Add to Pro"
            android:textSize="12sp"
            android:textColor="#FFD700"
            app:icon="@drawable/ic_add"
            app:iconSize="14dp"
            app:iconTint="#FFD700"
            app:iconPadding="3dp"
            app:iconGravity="textStart"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="8dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/remove_from_pro_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:text="Remove from Pro"
            android:textSize="12sp"
            android:textColor="#FF9800"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="8dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Hidden views kept for Java (adapter) compatibility. -->
    <LinearLayout
        android:id="@+id/main_actions_row"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:visibility="gone" />

    <TextView
        android:id="@+id/status_text"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- Inset hairline divider between rows (profile-style) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="11dp"
        android:background="#2C2C2C" />
</LinearLayout>
