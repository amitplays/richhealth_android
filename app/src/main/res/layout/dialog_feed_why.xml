<?xml version="1.0" encoding="utf-8"?>
<!-- "Why Richie picked this" — a designed explanation for the personalized feed.
     Uses the app dialog surface + blue accent; leads with the Richie logo and
     highlights the reason in an accent panel. Shown from the feed card's why-icon. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_surface"
    android:paddingHorizontal="22dp"
    android:paddingTop="22dp"
    android:paddingBottom="16dp">

    <!-- Header: Richie logo + title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_richie_ai"
            android:contentDescription="Richie" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Why Richie picked this"
            android:textColor="@color/rh_accent"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="#2A2A2A" />

    <!-- Intro -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Richie reads your health profile and, based on your interests and location, curates a feed that's relevant to you."
        android:textColor="@color/rh_text_secondary"
        android:textSize="13.5sp"
        android:lineSpacingExtra="2dp" />

    <!-- Reason highlight -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_reason_box"
        android:padding="12dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_richie_ai"
            android:contentDescription="Reason" />

        <TextView
            android:id="@+id/why_reason"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/rh_accent"
            android:textSize="13.5sp"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingExtra="1dp" />
    </LinearLayout>

    <!-- Footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Powered by Richie AI"
            android:textColor="@color/rh_text_tertiary"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/why_got_it"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Got it"
            android:textColor="@color/white"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            app:backgroundTint="@color/rh_accent"
            app:cornerRadius="12dp"
            app:elevation="0dp" />
    </LinearLayout>
</LinearLayout>
