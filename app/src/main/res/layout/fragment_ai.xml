<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/black"
    android:focusableInTouchMode="true">

    <!-- ─── Top bar (Material app-bar height, 48dp touch targets) ───
         History (left) · active-chat title (center, shrunk) · New chat (right).
         No logo / no "Richie" here anymore — the logo lives by the salutation. -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <!-- Left: chat history — opens the side panel -->
        <ImageButton
            android:id="@+id/chat_history_button"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/chat_history_icon"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Chat history"
            app:tint="#C4CFCF"
            android:padding="9dp"
            android:scaleType="fitCenter"/>

        <!-- Right: new chat (compose) -->
        <ImageButton
            android:id="@+id/new_chat_header_button"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/new_chat_icon"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="New chat"
            app:tint="#008b8b"
            android:padding="9dp"
            android:scaleType="fitCenter"/>

        <!-- Center: active chat title / summary. Empty while on a new chat,
             set to the session title (shrunk) once a chat is open. -->
        <TextView
            android:id="@+id/header_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/chat_history_button"
            android:layout_toStartOf="@id/new_chat_header_button"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:text=""
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/white"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Hidden compatibility views — Java still references these IDs. -->
        <TextView
            android:id="@+id/header_subtitle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:text="" />

        <TextView
            android:id="@+id/usage_text"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <!-- [PLAN-PILL-REVIEW] removed (hardcoded/dead plan pill) -->
    </RelativeLayout>

    <!-- Subtle separator -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#1A1A1A"/>

    <!-- ─── Chat Area ─── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chat_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"/>

        <!-- ─── Empty State / Welcome Screen ───
             Wrapped in a ScrollView so that when the keyboard shrinks the chat area the welcome
             content scrolls instead of being clipped at the bottom. fillViewport keeps it
             vertically centred when there is room (the child is stretched to the viewport and the
             LinearLayout's center_vertical gravity centres within it); once the content is taller
             than the shrunken viewport it simply scrolls. -->
        <!-- id + default gone: this wrapper must be hidden whenever the chat list is
             shown, otherwise it sits on top of the RecyclerView and eats all touches
             (scroll/taps) on the message bubbles. Toggled with the welcome state in
             AIFragment via setWelcomeVisibility(). -->
        <ScrollView
            android:id="@+id/welcome_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:scrollbars="none"
            android:visibility="gone">

        <LinearLayout
            android:id="@+id/empty_state_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <!-- Salutation logo — spins while the first message is in flight,
                 then cross-fades into the first chat's icon. -->
            <ImageView
                android:id="@+id/welcome_logo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_launcher"
                android:layout_marginBottom="14dp"
                android:contentDescription="Richie" />

            <TextView
                android:id="@+id/welcome_greeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="What can I help with?"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold"
                android:letterSpacing="-0.01"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ask about your reports, symptoms or medications. I answer using what I know about you."
                android:textColor="#5F6E6E"
                android:textSize="13.5sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="26dp"/>

            <!-- Data context summary — populated from cache in Java -->
            <TextView
                android:id="@+id/health_data_context"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#008b8b"
                android:textSize="12sp"
                android:layout_marginBottom="18dp"
                android:visibility="gone"/>

            <!-- Tailored starter suggestions (rows built in AIFragment) -->
            <LinearLayout
                android:id="@+id/suggestion_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Data-aware nudge — text + icon set in code from the user's data gaps.
                 Shown only when there is nothing to work with yet. -->
            <LinearLayout
                android:id="@+id/hint_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_nudge"
                android:paddingStart="14dp"
                android:paddingEnd="12dp"
                android:paddingTop="13dp"
                android:paddingBottom="13dp"
                android:layout_marginTop="22dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/hint_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_lab_profile"
                    app:tint="#008b8b"
                    android:contentDescription="Add health data" />

                <TextView
                    android:id="@+id/hint_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="11dp"
                    android:text="Add your reports and vitals so answers are made for you."
                    android:textColor="#AEC0C0"
                    android:textSize="12.5sp"
                    android:lineSpacingExtra="1dp" />

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_arrow_forward"
                    app:tint="#4A6A6A"
                    android:contentDescription="Add" />
            </LinearLayout>

        </LinearLayout>
        </ScrollView>

    </FrameLayout>

    <!-- ─── Hidden elements (Java compatibility — never rendered) ─── -->
    <ProgressBar
        android:id="@+id/usage_progress_bar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:max="100"
        android:progress="0" />

    <View
        android:id="@+id/border_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"/>

    <HorizontalScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/suggestion_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">
        <ImageButton
            android:id="@+id/saved_chats_button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/ic_bookmark_outline"
            android:contentDescription="Saved Chats"
            android:background="@null"/>
        <TextView
            android:id="@+id/saved_count"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="0"/>
        <ImageButton
            android:id="@+id/keep_history_button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/ic_history"
            android:contentDescription="Chat History"
            android:background="@null"/>
        <ImageButton
            android:id="@+id/restart_chat_button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/ic_menu_rotate"
            android:contentDescription="Clear Chat"
            android:background="@null"/>
    </LinearLayout>

    <!-- ─── Input Area ─── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="10dp"
        android:background="@color/black">

        <!-- Unified input card: textbox on top, action row (model pill · text-size · send) on bottom -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/input_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#111111"
            app:strokeColor="#008b8b"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="8dp"
                android:paddingTop="6dp"
                android:paddingBottom="8dp">

                <EditText
                    android:id="@+id/message_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ask about your health..."
                    android:textColorHint="#444444"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:background="@null"
                    android:paddingTop="6dp"
                    android:paddingBottom="2dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:maxLines="5"
                    android:inputType="textMultiLine|textCapSentences"
                    android:scrollbars="vertical"/>

                <!-- Bottom action row: model pill · usage ring · spacer · Aa · send -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <!-- Model selector — when Max is active this reads "Max ✦" -->
                    <LinearLayout
                        android:id="@+id/model_dropdown_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/model_pill_bg"
                        android:paddingStart="10dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/model_pill_icon"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginEnd="5dp"
                            android:src="@drawable/ic_model_auto"
                            app:tint="#008b8b"
                            android:contentDescription="Model logo" />

                        <TextView
                            android:id="@+id/model_pill_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Auto"
                            android:textColor="#008b8b"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:singleLine="true" />

                        <ImageView
                            android:layout_width="11dp"
                            android:layout_height="11dp"
                            android:layout_marginStart="3dp"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="#008b8b"
                            android:contentDescription="Pick AI model" />
                    </LinearLayout>

                    <!-- Health-profile selector pill (sits beside the model pill).
                         Shown only for accounts with family members, and only while
                         starting a new chat. Picking a family member turns the input
                         border white. -->
                    <LinearLayout
                        android:id="@+id/input_profile_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/model_pill_bg"
                        android:paddingStart="9dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:layout_marginStart="6dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/input_profile_icon"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginEnd="4dp"
                            android:src="@drawable/ic_person"
                            app:tint="#008b8b"
                            android:contentDescription="Health profile" />

                        <TextView
                            android:id="@+id/input_profile_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="You"
                            android:textColor="#008b8b"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:singleLine="true" />

                        <ImageView
                            android:id="@+id/input_profile_chevron"
                            android:layout_width="11dp"
                            android:layout_height="11dp"
                            android:layout_marginStart="3dp"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="#008b8b"
                            android:contentDescription="Switch health profile" />
                    </LinearLayout>

                    <!-- Usage ring -->
                    <FrameLayout
                        android:id="@+id/usage_ring_container"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Message usage"
                        android:layout_marginStart="4dp">

                        <Utils.UsageRing
                            android:id="@+id/usage_ring"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center" />
                    </FrameLayout>

                    <!-- Spacer pushes the right-side actions to the end. -->
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"/>

                    <!-- Text-size cycler (Aa) -->
                    <ImageButton
                        android:id="@+id/text_size_button"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_text_size"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        app:tint="#808080"
                        android:layout_marginEnd="2dp"
                        android:contentDescription="Change chat text size"/>

                    <!-- Send -->
                    <ImageButton
                        android:id="@+id/send_button"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_send_arrow"
                        android:background="@drawable/send_button_bg"
                        android:padding="8dp"
                        android:contentDescription="Send message" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- The standalone Max pill that used to sit between the model
             selector and the usage ring is gone — Max is now just another
             value of the model selector ("Max ✦"). These zero-size hidden
             stubs keep Java findViewById calls happy. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/max_mode_pill"
                android:layout_width="0dp"
                android:layout_height="0dp">
                <TextView
                    android:id="@+id/max_mode_pill_text"
                    android:layout_width="0dp"
                    android:layout_height="0dp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
