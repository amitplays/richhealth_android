<?xml version="1.0" encoding="utf-8"?>
<!-- Tap-to-open picker/date row. Matches the app's settings rows (label + value + chevron). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="4dp"
    android:paddingVertical="10dp"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/selectableItemBackground">

    <TextView
        android:id="@+id/picker_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="14sp"
        android:textColor="@color/rh_text_secondary"/>

    <TextView
        android:id="@+id/picker_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:maxWidth="180dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="end"
        android:textSize="14sp"
        android:textColor="@color/rh_text_primary"/>

    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_arrow_forward_ios"
        app:tint="@color/rh_text_tertiary"/>
</LinearLayout>
