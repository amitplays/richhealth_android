<?xml version="1.0" encoding="utf-8"?>
    <resources>
        <declare-styleable name="AnimatedActionButton">
            <attr name="actionIcon" format="reference"/>
            <attr name="buttonText" format="string"/>
        </declare-styleable>

        <!-- Reusable Services/Tools card (Utils.ServiceCardView). Runtime setters
             are the primary API; these attrs let the static cards declare their
             icon/title/subtitle straight from XML. -->
        <declare-styleable name="ServiceCardView">
            <attr name="serviceIcon" format="reference"/>
            <attr name="serviceTitle" format="string"/>
            <attr name="serviceSubtitle" format="string"/>
            <!-- Photo variant (Services redesign): bundled photo bg + teal→black scrim,
                 floating glass stat pill. serviceHero bumps min height / title size. -->
            <attr name="servicePhoto" format="reference"/>
            <attr name="serviceHero" format="boolean"/>
            <attr name="serviceStatLabel" format="string"/>
        </declare-styleable>
    </resources>