                                <View
                                    android:layout_width="0dp"
                                    android:layout_height="0dp"
                                    android:layout_weight="1" />

                                <TextView
                                    android:id="@+id/hero_health_score_label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Profile Score"
                                    android:textColor="#808080"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <ProgressBar
                                android:id="@+id/hero_health_score_progress"
                                style="@android:style/Widget.ProgressBar.Horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="6dp"
                                android:max="100"
                                android:progress="0"
                                android:progressTint="#4CAF50"
                                android:progressBackgroundTint="#333333" />
                        </LinearLayout>

                        <!-- Status line (mapped to meaningful text) -->
                        <TextView
                            android:id="@+id/dialog_status_line"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#808080"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="10dp" />

                        <!-- AI Headline -->
                        <TextView
                            android:id="@+id/dialog_headline_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/white"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:lineSpacingMultiplier="1.3"
                            android:layout_marginBottom="6dp" />

                        <!-- Reason -->
                        <TextView
                            android:id="@+id/dialog_status_reason"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#999999"
                            android:textSize="13sp"
                            android:lineSpacingMultiplier="1.3"
                            android:layout_marginBottom="14dp" />

                        <!-- Bottom row: Refresh button + loading spinner + timestamp -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/dialog_refresh_button"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:text="Refresh"
                                android:textColor="#008b8b"
                                android:textSize="12sp"
                                android:minWidth="0dp"
                                android:paddingHorizontal="0dp"
                                app:icon="@drawable/ic_menu_rotate"
                                app:iconTint="#008b8b"
                                app:iconSize="14dp"
                                app:iconPadding="4dp" />

                            <!-- Loading spinner (shown during refresh) -->
                            <ProgressBar
                                android:id="@+id/dialog_refresh_progress"
                                android:layout_width="@dimen/icon_sm"
                                android:layout_height="@dimen/icon_sm"
                                android:indeterminate="true"
                                android:indeterminateTint="#008b8b"
                                android:visibility="gone" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <TextView
                                android:id="@+id/dialog_last_updated_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#666666"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════ CHANGE NOTIFICATION BANNER ═══════ -->
            <LinearLayout
                android:id="@+id/dialog_change_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_bg_warning"
                android:padding="12dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/dialog_change_banner_text"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Data changed since last analysis"
                    android:textColor="#FF9800"
                    android:textSize="12sp"
                    android:lineSpacingMultiplier="1.2" />

                <TextView
                    android:id="@+id/dialog_change_banner_refresh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Refresh ›"
                    android:textColor="#FF9800"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:paddingStart="12dp" />
            </LinearLayout>

            <!-- ═══════ ACTION ITEMS ═══════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/dialog_action_items_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#262626"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="@dimen/icon_sm"
                            android:layout_height="@dimen/icon_sm"
                            android:tag="section_icon"
                            android:src="@drawable/ic_clinical_notes"
                            app:tint="#008b8b"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Recommended Actions"
                            android:textColor="#008b8b"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/dialog_action_items_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════ DETAILED ANALYSIS CARD ═══════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/dialog_analysis_content_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#262626">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Title inside card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="@dimen/icon_sm"
                            android:layout_height="@dimen/icon_sm"
                            android:tag="section_icon"
                            android:src="@drawable/ic_diagnosis"
                            app:tint="#008b8b"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Detailed Analysis"
                            android:textColor="#008b8b"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Pill tabs inside card -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/dialog_analysis_tabs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:background="@drawable/pill_tab_container_bg"
                            android:padding="4dp">

                            <TextView
                                android:id="@+id/tab_reports"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Reports"
                                android:textSize="12sp"
                                android:textColor="#FFFFFF"
                                android:background="@drawable/pill_tab_selected"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="9dp"
                                android:clickable="true"
                                android:focusable="true" />

                            <TextView
                                android:id="@+id/tab_symptoms"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Symptoms"
                                android:textSize="12sp"
                                android:textColor="#AAAAAA"
                                android:background="@drawable/pill_tab_unselected"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="9dp"
                                android:clickable="true"
                                android:focusable="true" />

                            <TextView
                                android:id="@+id/tab_medications"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Medications"
                                android:textSize="12sp"
                                android:textColor="#AAAAAA"
                                android:background="@drawable/pill_tab_unselected"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="9dp"
                                android:clickable="true"
                                android:focusable="true" />

                            <TextView
                                android:id="@+id/tab_measurements"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Measurements"
                                android:textSize="12sp"
                                android:textColor="#AAAAAA"
                                android:background="@drawable/pill_tab_unselected"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="9dp"
                                android:clickable="true"
                                android:focusable="true" />

                            <TextView
                                android:id="@+id/tab_genetics"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Family Health"
                                android:textSize="12sp"
                                android:textColor="#AAAAAA"
                                android:background="@drawable/pill_tab_unselected"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="9dp"
                                android:clickable="true"
                                android:focusable="true" />

                            <TextView
                                android:id="@+id/tab_diagnostics"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Diagnostics"
                                android:textSize="12sp"
                                android:textColor="#AAAAAA"
                                android:background="@drawable/pill_tab_unselected"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="9dp"
                                android:clickable="true"
                                android:focusable="true" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <!-- Shimmer skeleton placeholder -->
                    <LinearLayout
                        android:id="@+id/dialog_analysis_shimmer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <View
                            android:layout_width="140dp"
                            android:layout_height="@dimen/icon_xs"
                            android:background="@drawable/shimmer_placeholder_bg"
                            android:layout_marginBottom="12dp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="10dp"
                            android:background="@drawable/shimmer_placeholder_bg"
                            android:layout_marginBottom="8dp" />

                        <View
                            android:layout_width="240dp"
                            android:layout_height="10dp"
                            android:background="@drawable/shimmer_placeholder_bg"
                            android:layout_marginBottom="8dp" />

                        <View
                            android:layout_width="100dp"
                            android:layout_height="12dp"
                            android:background="@drawable/shimmer_placeholder_bg"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="10dp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="10dp"
                            android:background="@drawable/shimmer_placeholder_bg"
                            android:layout_marginBottom="8dp" />

                        <View
                            android:layout_width="200dp"
                            android:layout_height="10dp"
                            android:background="@drawable/shimmer_placeholder_bg"
                            android:layout_marginBottom="8dp" />

                        <View
                            android:layout_width="260dp"
                            android:layout_height="10dp"
                            android:background="@drawable/shimmer_placeholder_bg" />
                    </LinearLayout>

                    <!-- Summary text -->
                    <TextView
                        android:id="@+id/dialog_analysis_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#E0E0E0"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.4"
                        android:visibility="gone" />

                    <!-- Dynamic details container -->
                    <LinearLayout
                        android:id="@+id/dialog_analysis_details_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />

                    <!-- No data / error message -->
                    <TextView
                        android:id="@+id/dialog_analysis_no_data"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#888888"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:padding="20dp"
                        android:text="Tap Refresh Analysis to generate insights"
                        android:visibility="visible" />

                    <!-- Generated timestamp -->
                    <TextView
                        android:id="@+id/dialog_analysis_generated_at"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#555555"
                        android:textSize="11sp"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════ PROFILE SNAPSHOT ═══════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#262626">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">

                        <ImageView
                            android:layout_width="@dimen/icon_sm"
                            android:layout_height="@dimen/icon_sm"
                            android:tag="section_icon"
                            android:src="@drawable/ic_patient_list"
                            app:tint="#008b8b"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Your Health Data"
                            android:textColor="#008b8b"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Row 1: Age · Gender · Blood Type -->
                    <LinearLayout
                        android:id="@+id/dialog_stats_row1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <!-- Age cell -->
                        <LinearLayout
                            android:id="@+id/dialog_cell_age"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:minHeight="56dp"
                            android:orientation="vertical"
                            android:background="@drawable/profile_pill_bg"
                            android:backgroundTint="#1E1E1E"
                            android:padding="10dp"
                            android:layout_marginEnd="6dp">

                            <TextView
                                android:id="@+id/dialog_pill_age"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="–"
                                android:textColor="#808080"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Age"
                                android:textColor="#666666"
                                android:textSize="11sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Gender cell -->
                        <LinearLayout
                            android:id="@+id/dialog_cell_gender"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:minHeight="56dp"
                            android:orientation="vertical"
                            android:background="@drawable/profile_pill_bg"
                            android:backgroundTint="#1E1E1E"
                            android:padding="10dp"
                            android:layout_marginEnd="6dp">

                            <TextView
                                android:id="@+id/dialog_pill_gender"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="–"
                                android:textColor="#808080"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Gender"
                                android:textColor="#666666"
                                android:textSize="11sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Blood Type cell -->
                        <LinearLayout
                            android:id="@+id/dialog_cell_blood"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:minHeight="56dp"
                            android:orientation="vertical"
                            android:background="@drawable/profile_pill_bg"
                            android:backgroundTint="#1E1E1E"
                            android:padding="10dp">

                            <TextView
                                android:id="@+id/dialog_pill_blood"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="–"
                                android:textColor="#808080"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Blood"
                                android:textColor="#666666"
                                android:textSize="11sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Row 2: Weight · BMI · Sleep -->
                    <LinearLayout
                        android:id="@+id/dialog_stats_row2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <!-- Weight cell -->
                        <LinearLayout
                            android:id="@+id/dialog_cell_weight"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:minHeight="56dp"
                            android:orientation="vertical"
                            android:background="@drawable/profile_pill_bg"
                            android:backgroundTint="#1E1E1E"
                            android:padding="10dp"
                            android:layout_marginEnd="6dp">

                            <TextView
                                android:id="@+id/dialog_pill_weight"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="–"
                                android:textColor="#808080"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Weight"
                                android:textColor="#666666"
                                android:textSize="11sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- BMI cell -->
                        <LinearLayout
                            android:id="@+id/dialog_cell_bmi"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:minHeight="56dp"
                            android:orientation="vertical"
                            android:background="@drawable/profile_pill_bg"
                            android:backgroundTint="#1E1E1E"
                            android:padding="10dp"
                            android:layout_marginEnd="6dp">

                            <TextView
                                android:id="@+id/dialog_pill_bmi"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="–"
                                android:textColor="#808080"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/dialog_pill_bmi_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="BMI"
                                android:textColor="#666666"
                                android:textSize="11sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Sleep cell -->
                        <LinearLayout
                            android:id="@+id/dialog_cell_sleep"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:minHeight="56dp"
                            android:orientation="vertical"
                            android:background="@drawable/profile_pill_bg"
                            android:backgroundTint="#1E1E1E"
                            android:padding="10dp">

                            <TextView
                                android:id="@+id/dialog_pill_sleep"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="–"
                                android:textColor="#808080"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Avg Sleep"
                                android:textColor="#666666"
                                android:textSize="11sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Complete profile CTA (shown when health data pills have "Not set" values) -->
                    <TextView
                        android:id="@+id/dialog_complete_profile_cta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Complete your profile for better insights ›"
                        android:textColor="#008b8b"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:layout_marginBottom="8dp"
                        android:visibility="gone"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Data on File summary -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Records on File"
                        android:textColor="#808080"
                        android:textSize="12sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/dialog_data_on_file_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="–"
                        android:textColor="#AAAAAA"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginBottom="14dp" />

                    <!-- Profile completion (conditional) -->
                    <LinearLayout
                        android:id="@+id/dialog_profile_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="6dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Profile Completion"
                                android:textColor="#808080"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/dialog_profile_percent_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#008b8b"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/dialog_profile_progress"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:max="100"
                            android:progress="0"
                            android:progressTint="#008b8b"
                            android:progressBackgroundTint="#333333" />

                        <TextView
                            android:id="@+id/dialog_missing_fields_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#808080"
                            android:textSize="11sp"
                            android:layout_marginTop="6dp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════ AIR QUALITY ═══════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/dialog_aqi_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#262626"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <!-- Top row: Status + AQI value badge -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:id="@+id/dialog_aqi_quality"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Moderate"
                            android:textColor="#FFFF00"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/dialog_aqi_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AQI 142"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:background="@drawable/profile_pill_bg"
                            android:backgroundTint="#333333" />
                    </LinearLayout>

                    <!-- Location row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="@dimen/icon_xs"
                            android:layout_height="@dimen/icon_xs"
                            android:tag="section_icon"
                            android:src="@drawable/ic_location"
                            app:tint="#808080"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/dialog_aqi_location"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Location"
                            android:textColor="#AAAAAA"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/dialog_aqi_records"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#808080"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Analysis summary line -->
                    <TextView
                        android:id="@+id/dialog_aqi_analysis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#999999"
                        android:textSize="11sp"
                        android:lineSpacingMultiplier="1.2"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/dialog_aqi_tap_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tap for details ›"
                        android:textColor="#008b8b"
                        android:textSize="11sp"
                        android:layout_marginTop="6dp"
                        android:gravity="end" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════ BOTTOM REFRESH BUTTON ═══════ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialog_bottom_refresh_button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Refresh Analysis"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                app:backgroundTint="#008B8B"
                app:cornerRadius="12dp" />

            </LinearLayout> <!-- closes cards container -->
        </LinearLayout> <!-- closes scroll root -->
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
</file>

<file path="app/src/main/res/layout/activity_health_assistant.xml">
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/black">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:background="@color/black">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Health Assistant"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Description -->
    <TextView
        android:id="@+id/dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chat anonymously with our AI. Your conversation is private and not saved."
        android:textColor="#808080"
        android:textSize="13sp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp" />

    <!-- Chat area -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="5dp"
        android:backgroundTint="#262626">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chat_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="8dp"
            android:background="@android:color/transparent" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Input area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingBottom="16dp">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/message_layout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:textColorHint="#757575"
            app:boxBackgroundColor="#262626"
            app:boxCornerRadiusTopStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxStrokeColor="#008b8b"
            app:boxStrokeWidth="1dp"
            app:hintTextColor="#008b8b">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/message_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:hint="Type your message here..."
                android:inputType="textMultiLine"
                android:minLines="2"
                android:textColor="@color/white" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/send_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Send"
            android:textColor="@color/white"
            app:backgroundTint="#008b8b"
            app:cornerRadius="8dp" />
    </LinearLayout>
</LinearLayout>
</file>

<file path="app/src/main/res/layout/activity_health_feed.xml">
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/black">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:background="@color/black">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Health Intel"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Podcasts, articles, and health news for you"
        android:textColor="#808080"
        android:textSize="13sp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp" />

    <!-- Filter chips row -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingVertical="12dp"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:id="@+id/filter_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_all"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="All"
                android:textColor="@color/white"
                android:textSize="13sp"
                app:chipBackgroundColor="#008b8b"
                app:chipCornerRadius="18dp"
                app:chipStrokeWidth="0dp"
                app:checkedIconVisible="false"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_podcasts"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Podcasts"
                android:textColor="#999999"
                android:textSize="13sp"
                app:chipBackgroundColor="#262626"
                app:chipCornerRadius="18dp"
                app:chipStrokeWidth="0dp"
                app:checkedIconVisible="false"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_articles"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Articles"
                android:textColor="#999999"
                android:textSize="13sp"
                app:chipBackgroundColor="#262626"
                app:chipCornerRadius="18dp"
                app:chipStrokeWidth="0dp"
                app:checkedIconVisible="false"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_news"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="News"
                android:textColor="#999999"
                android:textSize="13sp"
                app:chipBackgroundColor="#262626"
                app:chipCornerRadius="18dp"
                app:chipStrokeWidth="0dp"
                app:checkedIconVisible="false" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Feed list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/feed_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:padding="40dp">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_podcast"
            android:alpha="0.3"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No content yet"
            android:textColor="#808080"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Health articles, podcasts and news will appear here"
            android:textColor="#666666"
            android:textSize="13sp"
            android:gravity="center" />
    </LinearLayout>

    <!-- Mini player bar (for podcasts) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/feed_mini_player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#262626">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="@dimen/icon_lg"
                    android:layout_height="@dimen/icon_lg"
                    android:src="@drawable/ic_podcast"
                    app:tint="#008b8b"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/feed_mini_player_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/feed_mini_player_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#808080"
                    android:textSize="11sp"
                    android:layout_marginEnd="8dp" />

                <ImageButton
                    android:id="@+id/feed_mini_play_pause"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_play"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="#008b8b" />

                <ImageButton
                    android:id="@+id/feed_mini_close"
                    android:layout_width="@dimen/icon_container_sm"
                    android:layout_height="@dimen/icon_container_sm"
                    android:src="@drawable/ic_close"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="8dp"
                    app:tint="#808080"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/feed_mini_seekbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:progressTint="#008b8b"
                android:thumbTint="#008b8b"
                android:progressBackgroundTint="#444444"
                android:maxHeight="2dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
</file>

<file path="app/src/main/res/layout/activity_login.xml">
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <!-- Logo and App Name -->
        <ImageView
            android:id="@+id/logo"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_launcher"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RichHealth"
            android:id="@+id/title"
            android:textColor="#008b8b"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp"/>

        <!-- Login Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/login_card"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="#1A1A1A"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome Back"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="24dp"/>

                <!-- Email Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/email_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:boxBackgroundColor="#262626"
                    app:boxStrokeColor="#008b8b"
                    app:boxStrokeWidth="1dp"
                    app:hintTextColor="#008b8b"
                    android:textColorHint="#757575"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/email_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Email"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/white"
                        android:textSize="16sp"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Password Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/password_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:boxBackgroundColor="#262626"
                    app:boxStrokeColor="#008b8b"
                    app:boxStrokeWidth="1dp"
                    app:hintTextColor="#008b8b"
                    android:textColorHint="#757575"
                    app:passwordToggleEnabled="true"
                    app:passwordToggleTint="#008b8b"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/password_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Password"
                        android:inputType="textPassword"
                        android:textColor="@color/white"
                        android:textSize="16sp"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Forgot Password -->
                <TextView
                    android:id="@+id/forgot_password"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Forgot Password?"
                    android:textColor="#008b8b"
                    android:textSize="14sp"
                    android:layout_gravity="end"
                    android:layout_marginBottom="24dp"/>

                <!-- Login Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/login_button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Login"
                    android:textSize="16sp"
                    android:textAllCaps="false"
                    app:cornerRadius="8dp"
                    app:backgroundTint="#008b8b"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Sign Up Link -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:id="@+id/signup_layout"
            android:layout_marginTop="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Don't have an account? "
                android:textColor="#757575"
                android:textSize="16sp"/>

            <TextView
                android:id="@+id/signup_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign Up"
                android:layout_gravity="center"
                android:textColor="#008b8b"
                android:textSize="20sp"
                android:padding="10dp"
                android:textStyle="bold"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
</file>

<file path="app/src/main/res/layout/activity_main.xml">
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/border_view" />

    <View
        android:id="@+id/border_view"
        android:layout_width="match_parent"
        android:layout_height="0.1dp"
        android:background="#47999999"
        app:layout_constraintTop_toBottomOf="@id/fragment_container"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#000000"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_navigation_menu"
        app:itemIconSize="@dimen/icon_nav"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
