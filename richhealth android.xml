<file path="app/src/main/res/layout/fragment_activity_timeline.xml">
<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Loading state -->
    <LinearLayout
        android:id="@+id/loading_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:indeterminateTint="#008b8b" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loading activity..."
            android:textColor="#808080"
            android:textSize="13sp"
            android:layout_marginTop="12dp" />
    </LinearLayout>

    <!-- Timeline list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/timeline_recycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="12dp"
        android:paddingBottom="16dp" />

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:padding="40dp">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_analysis"
            android:alpha="0.3"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No recent activity"
            android:textColor="#808080"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your health activity timeline will appear here"
            android:textColor="#666666"
            android:textSize="13sp"
            android:gravity="center" />
    </LinearLayout>
</FrameLayout>
</file>

<file path="app/src/main/res/layout/fragment_ai.xml">
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/black">

    <!-- ─── Top bar (clean, calm) ─── -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:paddingStart="14dp"
        android:paddingEnd="6dp">

        <!-- Right cluster: new chat · history -->
        <LinearLayout
            android:id="@+id/header_right_section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/new_chat_header_button"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_chat"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="New chat"
                app:tint="#008b8b"
                android:padding="8dp"
                android:scaleType="fitCenter"/>

            <ImageButton
                android:id="@+id/chat_history_button"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_history"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Chat history"
                app:tint="#FFFFFF"
                android:padding="8dp"
                android:scaleType="fitCenter"/>
        </LinearLayout>

        <!-- Left: logo + name -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/header_right_section"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="8dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_launcher"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Richie"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Hidden compatibility views — Java still references these IDs. -->
        <TextView
            android:id="@+id/header_subtitle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:text="" />

        <TextView
            android:id="@+id/usage_text"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/plan_label"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </RelativeLayout>

    <!-- Subtle separator -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#1A1A1A"/>

    <!-- ─── Chat Area ─── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chat_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"/>

        <!-- ─── Empty State / Welcome Screen ─── -->
        <LinearLayout
            android:id="@+id/empty_state_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <!-- App logo -->
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_launcher"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/welcome_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="What can I help with?"
                android:textColor="#CCCCCC"
                android:textSize="19sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <!-- Data context summary — populated from cache in Java -->
            <TextView
                android:id="@+id/health_data_context"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#008b8b"
                android:textSize="12sp"
                android:layout_marginBottom="20dp"
                android:visibility="gone"/>

            <!-- ─── Dependent Selector Card ─── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/dependent_selector_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#0CFFFFFF"
                app:strokeColor="#1A3333"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingTop="14dp"
                    android:layout_marginBottom="6dp"
                    android:paddingBottom="16dp">

                    <!-- Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="You have dependents on your account"
                        android:textColor="#999999"
                        android:textSize="12sp"
                        android:layout_marginBottom="6dp" />

                    <!-- Title + description -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Who would you like to chat about?"
                        android:textColor="#E0E0E0"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <!-- Selector button — full-width, prominent -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/dependent_dropdown_button"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="Myself ▾"
                        android:textSize="14sp"
                        android:textColor="#008b8b"
                        android:textAllCaps="false"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="44dp"
                        android:gravity="center"
                        app:cornerRadius="12dp"
                        app:strokeColor="#008b8b"
                        app:strokeWidth="1dp"
                        app:backgroundTint="#0CFFFFFF"
                        app:rippleColor="#0CFFFFFF"
                        app:icon="@drawable/ic_person"
                        app:iconTint="#008b8b"
                        app:iconSize="18dp"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Hint box — shown only when no health data -->
            <LinearLayout
                android:id="@+id/hint_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/hint_box_bg"
                android:padding="10dp"
                android:layout_marginBottom="20dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add health reports, symptoms &amp; medications for personalized answers"
                    android:textColor="#555555"
                    android:textSize="12sp"
                    android:textAlignment="center"
                    android:lineSpacingExtra="2dp"/>

            </LinearLayout>

            <!-- Row 1 pills (auto-glides right) -->
            <HorizontalScrollView
                android:id="@+id/suggestion_scroll_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:fadingEdgeLength="20dp"
                android:requiresFadingEdge="horizontal">

                <LinearLayout
                    android:id="@+id/suggestion_pills_row1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"/>

            </HorizontalScrollView>

            <!-- Row 2 pills (auto-glides left) -->
            <HorizontalScrollView
                android:id="@+id/suggestion_scroll_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:fadingEdgeLength="20dp"
                android:requiresFadingEdge="horizontal">

                <LinearLayout
                    android:id="@+id/suggestion_pills_row2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"/>

            </HorizontalScrollView>

        </LinearLayout>

    </FrameLayout>

    <!-- ─── Hidden elements (Java compatibility — never rendered) ─── -->
    <ProgressBar
        android:id="@+id/usage_progress_bar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:max="100"
        android:progress="0" />

    <View
        android:id="@+id/border_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"/>

    <HorizontalScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/suggestion_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">
        <ImageButton
            android:id="@+id/saved_chats_button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/ic_bookmark_outline"
            android:contentDescription="Saved Chats"
            android:background="@null"/>
        <TextView
            android:id="@+id/saved_count"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="0"/>
        <ImageButton
            android:id="@+id/keep_history_button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/ic_history"
            android:contentDescription="Chat History"
            android:background="@null"/>
        <ImageButton
            android:id="@+id/restart_chat_button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/ic_menu_rotate"
            android:contentDescription="Clear Chat"
            android:background="@null"/>
    </LinearLayout>

    <!-- ─── Input Area ─── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="10dp"
        android:background="@color/black">

        <!-- Unified input card: textbox on top, action row (model pill · text-size · send) on bottom -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/input_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#111111"
            app:strokeColor="#008b8b"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="8dp"
                android:paddingTop="6dp"
                android:paddingBottom="8dp">

                <EditText
                    android:id="@+id/message_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ask about your health..."
                    android:textColorHint="#444444"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:background="@null"
                    android:paddingTop="6dp"
                    android:paddingBottom="2dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:maxLines="5"
                    android:inputType="textMultiLine|textCapSentences"
                    android:scrollbars="vertical"/>

                <!-- Bottom action row: model pill · usage ring · spacer · Aa · send -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <!-- Model selector — when Max is active this reads "Max ✦" -->
                    <LinearLayout
                        android:id="@+id/model_dropdown_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/model_pill_bg"
                        android:paddingStart="10dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/model_pill_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Auto"
                            android:textColor="#008b8b"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:singleLine="true" />

                        <ImageView
                            android:layout_width="11dp"
                            android:layout_height="11dp"
                            android:layout_marginStart="3dp"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="#008b8b"
                            android:contentDescription="Pick AI model" />
                    </LinearLayout>

                    <!-- Usage ring -->
                    <FrameLayout
                        android:id="@+id/usage_ring_container"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Message usage"
                        android:layout_marginStart="4dp">

                        <Utils.UsageRing
                            android:id="@+id/usage_ring"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center" />
                    </FrameLayout>

                    <!-- Spacer pushes the right-side actions to the end. -->
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"/>

                    <!-- Text-size cycler (Aa) -->
                    <ImageButton
                        android:id="@+id/text_size_button"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_text_size"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        app:tint="#808080"
                        android:layout_marginEnd="2dp"
                        android:contentDescription="Change chat text size"/>

                    <!-- Send -->
                    <ImageButton
                        android:id="@+id/send_button"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_send_arrow"
                        android:background="@drawable/send_button_bg"
                        android:padding="8dp"
                        android:contentDescription="Send message" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- The standalone Max pill that used to sit between the model
             selector and the usage ring is gone — Max is now just another
             value of the model selector ("Max ✦"). These zero-size hidden
             stubs keep Java findViewById calls happy. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/max_mode_pill"
                android:layout_width="0dp"
                android:layout_height="0dp">
                <TextView
                    android:id="@+id/max_mode_pill_text"
                    android:layout_width="0dp"
                    android:layout_height="0dp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
</file>

<file path="app/src/main/res/layout/fragment_checkin_current.xml">
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/black">

    <!-- Loading state -->
    <LinearLayout
        android:id="@+id/loading_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="48dp"
        android:visibility="visible">

        <ProgressBar
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:indeterminateTint="#008b8b" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loading check-ins..."
            android:textColor="#808080"
            android:textSize="13sp"
            android:layout_marginTop="12dp" />
    </LinearLayout>

    <!-- No access state (free users) -->
    <LinearLayout
        android:id="@+id/no_access_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="48dp"
        android:paddingHorizontal="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_lock"
            app:tint="#008b8b"
            android:layout_marginBottom="12dp"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Check-Ins Unavailable"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Daily and weekly check-ins require Ultra. Monthly check-ins require Pro or above."
            android:textColor="#808080"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="48dp"
        android:paddingHorizontal="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No check-ins available"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your check-in sessions will appear here."
            android:textColor="#808080"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- Error state -->
    <LinearLayout
        android:id="@+id/error_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="48dp"
        android:paddingHorizontal="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Could not load check-ins"
            android:textColor="#808080"
            android:textSize="13sp"
            android:gravity="center" />
    </LinearLayout>

    <!-- Sessions list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/sessions_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:paddingHorizontal="16dp"
        android:clipToPadding="false"
        android:visibility="gone" />

</LinearLayout>
</file>

