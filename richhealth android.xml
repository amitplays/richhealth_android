    private void showModelSelectionDropdown() {
        boolean isPro = proStatusManager.isProUser();
        float dp = TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, 1, getResources().getDisplayMetrics());

        com.google.android.material.bottomsheet.BottomSheetDialog dialog =
                new com.google.android.material.bottomsheet.BottomSheetDialog(requireContext());

        LinearLayout container = new LinearLayout(requireContext());
        container.setOrientation(LinearLayout.VERTICAL);
        container.setPadding(0, (int)(8 * dp), 0, (int)(20 * dp));
        // Background is set on the BottomSheet's own surface (in setOnShowListener) so
        // we don't end up with two stacked rounded layers (BottomSheet + container)
        // creating a visible split at the corners.

        // Drag handle (material 1.7.0 doesn't ship BottomSheetDragHandleView yet)
        View handle = new View(requireContext());
        LinearLayout.LayoutParams handleParams = new LinearLayout.LayoutParams(
                (int)(36 * dp), (int)(4 * dp));
        handleParams.gravity = Gravity.CENTER_HORIZONTAL;
        handleParams.topMargin = (int)(10 * dp);
        handleParams.bottomMargin = (int)(16 * dp);
        handle.setLayoutParams(handleParams);
        GradientDrawable handleBg = new GradientDrawable();
        handleBg.setCornerRadius(2 * dp);
        handleBg.setColor(Color.parseColor("#333333"));
        handle.setBackground(handleBg);
        container.addView(handle);

        // Optional header — only when forking, so the user knows context is being preserved
        if (pendingForkContext != null) {
            TextView title = new TextView(requireContext());
            title.setText("Pick AI for forked chat");
            title.setTextSize(TypedValue.COMPLEX_UNIT_SP, 16);
            title.setTypeface(null, android.graphics.Typeface.BOLD);
            title.setTextColor(Color.parseColor("#E0E0E0"));
            title.setPadding((int)(24 * dp), (int)(4 * dp), (int)(24 * dp), (int)(4 * dp));
            container.addView(title);

            TextView sub = new TextView(requireContext());
            sub.setText(pendingForkContext.size() + " messages from "
                    + (pendingForkSourceModel == null ? "current chat" : pendingForkSourceModel)
                    + " will appear as a tappable bubble in the new chat.");
            sub.setTextSize(TypedValue.COMPLEX_UNIT_SP, 12);
            sub.setTextColor(Color.parseColor("#7A9999"));
            sub.setPadding((int)(24 * dp), 0, (int)(24 * dp), (int)(14 * dp));
            container.addView(sub);
        }

        // Max mode hero card sits above the single-model list because Max is the
        // headline feature. The CTA inside delegates to attemptSelectMaxMode, which
        // pro-gates and starts a fresh chat when toggled mid-conversation.
        container.addView(buildMaxHeroCard(dp, dialog));

        // Section label so the rest of the sheet reads as "or pick one model"
        TextView sectionLabel = new TextView(requireContext());
        sectionLabel.setText("Or pick a single model");
        sectionLabel.setTextSize(TypedValue.COMPLEX_UNIT_SP, 11);
        sectionLabel.setTextColor(Color.parseColor("#666666"));
        sectionLabel.setAllCaps(true);
        sectionLabel.setLetterSpacing(0.08f);
        sectionLabel.setPadding((int)(24 * dp), (int)(18 * dp), (int)(24 * dp), (int)(8 * dp));
        container.addView(sectionLabel);

        for (int i = 0; i < AI_MODELS.length; i++) {
            String[] model = AI_MODELS[i];
            String name = model[0];
            String id = model[1];
            boolean requiresPro = model[2].equals("true");
            boolean isSelected = id.equals(currentModel);

            LinearLayout row = new LinearLayout(requireContext());
            row.setOrientation(LinearLayout.HORIZONTAL);
            row.setGravity(Gravity.CENTER_VERTICAL);
            row.setPadding((int)(24 * dp), (int)(15 * dp), (int)(24 * dp), (int)(15 * dp));

            if (isSelected) {
                row.setBackgroundColor(Color.parseColor("#0D1A1A"));
            } else {
                TypedValue outValue = new TypedValue();
                requireContext().getTheme().resolveAttribute(
                        android.R.attr.selectableItemBackground, outValue, true);
                row.setBackgroundResource(outValue.resourceId);
            }

            // Model name
            TextView nameView = new TextView(requireContext());
            nameView.setText(name);
            nameView.setTextSize(TypedValue.COMPLEX_UNIT_SP, 15);
            nameView.setTextColor(isSelected ? Color.parseColor("#008b8b") : Color.parseColor("#CCCCCC"));
            LinearLayout.LayoutParams nameParams = new LinearLayout.LayoutParams(
                    0, LinearLayout.LayoutParams.WRAP_CONTENT, 1);
            nameView.setLayoutParams(nameParams);
            row.addView(nameView);

            // PRO badge
            if (requiresPro) {
                TextView proBadge = new TextView(requireContext());
                proBadge.setText("PRO");
                proBadge.setTextSize(TypedValue.COMPLEX_UNIT_SP, 9);
                proBadge.setTextColor(Color.parseColor("#FFD700"));
                proBadge.setPadding((int)(8 * dp), (int)(3 * dp), (int)(8 * dp), (int)(3 * dp));

                GradientDrawable badgeBg = new GradientDrawable();
                badgeBg.setCornerRadius(10 * dp);
                badgeBg.setColor(Color.parseColor("#1A1500"));
                badgeBg.setStroke(1, Color.parseColor("#332D00"));
                proBadge.setBackground(badgeBg);

                LinearLayout.LayoutParams badgeParams = new LinearLayout.LayoutParams(
                        LinearLayout.LayoutParams.WRAP_CONTENT,
                        LinearLayout.LayoutParams.WRAP_CONTENT);
                badgeParams.setMarginStart((int)(12 * dp));
                proBadge.setLayoutParams(badgeParams);
                row.addView(proBadge);
            }

            // Selected checkmark
            if (isSelected) {
                TextView check = new TextView(requireContext());
                check.setText("\u2713");
                check.setTextSize(TypedValue.COMPLEX_UNIT_SP, 15);
                check.setTextColor(Color.parseColor("#008b8b"));
                LinearLayout.LayoutParams checkParams = new LinearLayout.LayoutParams(
                        LinearLayout.LayoutParams.WRAP_CONTENT,
                        LinearLayout.LayoutParams.WRAP_CONTENT);
                checkParams.setMarginStart((int)(12 * dp));
                check.setLayoutParams(checkParams);
                row.addView(check);
            }

            row.setOnClickListener(v -> {
                if (requiresPro && !isPro) {
                    dialog.dismiss();
                    new android.app.AlertDialog.Builder(requireContext())
                            .setTitle("Pro Feature")
                            .setMessage(name + " is available on Pro and above. Upgrade to unlock all AI models including the full council mode.")
                            .setPositiveButton("Upgrade", (d, w) ->
                                    new Utils.ProUpgradeDialog(requireActivity()).show(isProNow -> {}))
                            .setNegativeButton("Not Now", null)
                            .show();
                    return;
                }
                currentModel = id;
                selectedModel = name;
                applyModelToUi(name);

                // Snapshot fork staging BEFORE dismiss, since the dismiss listener
                // clears it (so a swipe-down counts as a cancellation).
                List<ChatMessage> stagedFork = pendingForkContext;
                String stagedFromModel = pendingForkSourceModel;
                String stagedSessionId = pendingForkSourceSessionId;
                String stagedTitle = pendingForkSourceTitle;
                String stagedModelId = pendingForkSourceModelId;
                String stagedDependentId = pendingForkSourceDependentId;
                pendingForkContext = null;
                pendingForkSourceModel = null;
                pendingForkSourceSessionId = null;
                pendingForkSourceTitle = null;
                pendingForkSourceModelId = null;
                pendingForkSourceDependentId = null;

                dialog.dismiss();

                // Non-blocking model availability check (skip for "auto" — always available)
                if (!"auto".equals(id)) {
                    checkModelStatus(id, name);
                }

                // If a fork was staged, finalise it (open new chat + drop fork bubble).
                // Else keep the original "switch model mid-conversation = new chat" behaviour.
                if (stagedFork != null) {
                    finalizeForkAfterModelPick(stagedFork, stagedFromModel,
                            stagedSessionId, stagedTitle, stagedModelId, stagedDependentId);
                } else if (!isNewChatMode) {
                    startNewChatWithCurrentModel();
                }
            });

            container.addView(row);

            // Subtle divider (skip after last item)
            if (i < AI_MODELS.length - 1) {
                View divider = new View(requireContext());
                divider.setBackgroundColor(Color.parseColor("#1A1A1A"));
                LinearLayout.LayoutParams divParams = new LinearLayout.LayoutParams(
                        LinearLayout.LayoutParams.MATCH_PARENT, 1);
                divParams.setMarginStart((int)(24 * dp));
                divParams.setMarginEnd((int)(24 * dp));
                divider.setLayoutParams(divParams);
                container.addView(divider);
            }
        }

        dialog.setContentView(container);

        // Round the BottomSheet's own surface (otherwise its square edges peek out
        // behind our content). One layer, one set of rounded corners — no split.
        dialog.setOnShowListener(d -> {
            View sheet = dialog.findViewById(
                    com.google.android.material.R.id.design_bottom_sheet);
            if (sheet != null) {
                GradientDrawable sheetBg = new GradientDrawable();
                sheetBg.setColor(Color.parseColor("#111111"));
                sheetBg.setCornerRadii(new float[]{
                        20 * dp, 20 * dp,   // top-left
                        20 * dp, 20 * dp,   // top-right
                        0, 0,               // bottom-right
                        0, 0                // bottom-left
                });
                sheet.setBackground(sheetBg);
            }
        });

        // If the user dismisses without picking, drop any staged fork — they cancelled.
        dialog.setOnDismissListener(d -> {
            pendingForkContext = null;
            pendingForkSourceModel = null;
            pendingForkSourceSessionId = null;
            pendingForkSourceTitle = null;
            pendingForkSourceModelId = null;
            pendingForkSourceDependentId = null;
        });

        dialog.show();
    }

