</file>

<file path="app/src/main/res/layout/item_plan_card.xml">
<?xml version="1.0" encoding="utf-8"?>
<!--
    Full-page plan card used inside the pager RecyclerView.
    Width is set programmatically to (screenWidth - 80dp) for peek effect.
    Accent color (icon, price, stroke, stat values) is applied from Java per tier.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeWidth="1.5dp"
    app:strokeColor="#2E2E2E"
    app:cardBackgroundColor="#1E1E1E">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- ── Plan identity row ────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <FrameLayout
                    android:id="@+id/plan_icon_bg"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="12dp">
                    <ImageView
                        android:id="@+id/plan_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="3dp">

                        <TextView
                            android:id="@+id/plan_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="7dp" />

                        <!-- "BEST VALUE" chip — shown for isMostPopular plans -->
                        <TextView
                            android:id="@+id/plan_popular_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BEST VALUE"
                            android:textColor="#008b8b"
                            android:textSize="8sp"
                            android:textStyle="bold"
                            android:background="@drawable/chip_bg_teal_outline"
                            android:visibility="gone" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/plan_tagline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#5A5A5A"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- ── Price block ─────────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="10dp">

                <!-- Main price row: big price + discount message pill -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/plan_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="10dp" />

                    <!-- Discount message pill — e.g. "30% off — most popular" -->
                    <TextView
                        android:id="@+id/plan_discount_msg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/chip_bg_teal_outline"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:textColor="#00BFA5"
                        android:textSize="11sp"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Original price strikethrough + duration -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="3dp">

                    <TextView
                        android:id="@+id/plan_original_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#4A4A4A"
                        android:textSize="13sp"
                        android:layout_marginEnd="8dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/plan_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#4A4A4A"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- ── Key stats row — 3 tiles built programmatically ──────────── -->
            <LinearLayout
                android:id="@+id/plan_stats_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp" />

            <!-- ── Features section ─────────────────────────────────────────── -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="#2A2A2A"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WHAT'S INCLUDED"
                android:textColor="#505050"
                android:textSize="10sp"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:layout_marginBottom="7dp" />

            <!-- Feature rows — built programmatically -->
            <LinearLayout
                android:id="@+id/plan_features_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</com.google.android.material.card.MaterialCardView>
</file>

<file path="app/src/main/res/layout/item_podcast.xml">
<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@null"
    app:rippleColor="@android:color/transparent"
    app:cardCornerRadius="16dp"
    app:cardElevation="5dp"
    app:cardBackgroundColor="#1A1A1A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="5dp"
        android:padding="10dp">

        <!-- Title row with pill aligned -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/podcast_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_podcast"
                app:tint="#008b8b"
                android:layout_marginEnd="10dp"/>


            <!-- Title with ellipsis -->
            <TextView
                android:id="@+id/podcast_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Podcast Title"/>

            <!-- Pro/Free tag -->
            <TextView
                android:id="@+id/pro_tag"
                android:layout_width="42dp"
                android:layout_height="wrap_content"
                android:text="PRO"
                android:textColor="#000"
                android:textSize="12sp"
                android:padding="3dp"
                android:textAlignment="center"
                android:layout_marginStart="8dp"
                android:visibility="visible"/>
        </LinearLayout>

        <!-- Expandable content container -->
        <LinearLayout
            android:id="@+id/expandable_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Description with ellipsis for 3 lines -->
            <TextView
                android:id="@+id/podcast_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#808080"
                android:textSize="13sp"
                android:layout_marginTop="6dp"
                android:maxLines="3"
                android:ellipsize="end"
                android:text="Podcast Description"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/podcast_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#B1ACAC"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="Added: Jan 15, 2024"/>

                    <TextView
                        android:id="@+id/podcast_sources"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#808080"
                        android:textSize="11sp"
                        android:layout_marginTop="3dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="Sources"/>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/source_links_button"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_link"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="#008b8b"
                    android:layout_marginEnd="8dp"
                    android:layout_gravity="center_vertical"/>

                <ImageButton
                    android:id="@+id/play_pause_button"
                    android:layout_width="@dimen/icon_container_md"
                    android:layout_height="@dimen/icon_container_md"
                    android:src="@drawable/ic_play"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="8dp"
                    app:tint="#008b8b"
                    android:layout_gravity="center_vertical"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
</file>

<file path="app/src/main/res/layout/item_request_card.xml">
<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="#262626"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- Icon circle -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#1A3A3A"
            android:layout_marginEnd="14dp">

            <ImageView
                android:id="@+id/request_icon"
                android:layout_width="@dimen/icon_md"
                android:layout_height="@dimen/icon_md"
                android:layout_gravity="center"
                android:src="@drawable/ic_notification"
                app:tint="#008b8b" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/request_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="John Doe"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/request_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Wants to connect as your Doctor"
                android:textColor="#999999"
                android:textSize="13sp"
                android:layout_marginTop="2dp"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Action buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/reject_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Decline"
                    android:textColor="#FF5252"
                    android:textSize="12sp"
                    app:cornerRadius="8dp"
                    app:strokeColor="#FF5252"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/accept_button"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="Accept"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    app:backgroundTint="#008b8b"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </LinearLayout>
