        tv.setTypeface(null, android.graphics.Typeface.BOLD);
        int dp8 = (int) (8 * getResources().getDisplayMetrics().density);
        tv.setPadding(0, dp8 * 2, 0, dp8 / 2);
        container.addView(tv);
