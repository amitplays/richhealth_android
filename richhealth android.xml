<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/black"
    android:padding="16dp">

    <!-- Pending Requests List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/pending_requests_recycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:visibility="gone"/>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_hourglass"
            app:tint="#333333"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No Pending Requests"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You don't have any pending doctor connection requests. Find a doctor and send a connection request to get started."
            android:textColor="#808080"
            android:textSize="16sp"
            android:textAlignment="center"
            android:layout_marginBottom="24dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/find_doctor_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Find a Doctor"
            android:textAllCaps="false"
            app:cornerRadius="8dp"
            app:backgroundTint="#008b8b"/>
    </LinearLayout>
</LinearLayout>
</file>

<file path="app/src/main/res/layout/fragment_profile.xml">
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <LinearLayout
        android:id="@+id/profile_content_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ═══════ PROFILE HEADER ═══════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp"
            android:gravity="center_vertical">

            <!-- Avatar -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/rh_surface">

                <ImageView
                    android:layout_width="@dimen/icon_lg"
                    android:layout_height="@dimen/icon_lg"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_personf"
                    app:tint="#008b8b"/>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:id="@+id/profile_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="John Doe"
                    android:textColor="@color/white"
                    android:textSize="28sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/profile_email"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="john.doe@example.com"
                    android:textColor="#808080"
                    android:textSize="14sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <!-- Edit Profile Button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/edit_profile_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                app:cardBackgroundColor="@color/rh_surface">

                <ImageView
                    android:layout_width="@dimen/icon_sm"
                    android:layout_height="@dimen/icon_sm"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_edit"
                    app:tint="#008b8b"/>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Encryption trust chip -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_chip_encrypted"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_shield_lock"
                app:tint="#008b8b"
                android:layout_marginEnd="6dp"
                android:contentDescription="Encrypted" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="End-to-end encrypted · Only you have access"
                android:textColor="#008b8b"
                android:textSize="11sp"
                android:letterSpacing="0.04" />
        </LinearLayout>

        <!-- ═══════ PERSONAL INFO ═══════ -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Personal Info"
                android:textColor="#666666"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.14" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/rh_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Age -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">
                    <ImageView
                        android:layout_width="@dimen/icon_profile_row"
                        android:layout_height="@dimen/icon_profile_row"
                        android:src="@drawable/ic_cake"
                        app:tint="@color/rh_accent"
                        android:layout_marginEnd="14dp"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Age"
                        android:textColor="@color/rh_text_secondary"
                        android:textSize="15sp"/>
                    <TextView
                        android:id="@+id/age_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/empty_value"
                        android:textColor="@color/rh_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/rh_divider" android:layout_marginHorizontal="16dp"/>

                <!-- Gender -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">
                    <ImageView
                        android:layout_width="@dimen/icon_profile_row"
                        android:layout_height="@dimen/icon_profile_row"
                        android:src="@drawable/ic_gender"
                        app:tint="@color/rh_accent"
                        android:layout_marginEnd="14dp"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Gender"
                        android:textColor="@color/rh_text_secondary"
                        android:textSize="15sp"/>
                    <TextView
                        android:id="@+id/gender_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/empty_value"
                        android:textColor="@color/rh_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/rh_divider" android:layout_marginHorizontal="16dp"/>

                <!-- Phone -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">
                    <ImageView
                        android:layout_width="@dimen/icon_profile_row"
                        android:layout_height="@dimen/icon_profile_row"
                        android:src="@drawable/ic_phone"
                        app:tint="@color/rh_accent"
                        android:layout_marginEnd="14dp"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Phone"
                        android:textColor="@color/rh_text_secondary"
                        android:textSize="15sp"/>
                    <TextView
                        android:id="@+id/phone_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/empty_value"
                        android:textColor="@color/rh_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/rh_divider" android:layout_marginHorizontal="16dp"/>

                <!-- Location -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">
                    <ImageView
                        android:layout_width="@dimen/icon_profile_row"
                        android:layout_height="@dimen/icon_profile_row"
                        android:src="@drawable/ic_location"
                        app:tint="@color/rh_accent"
                        android:layout_marginEnd="14dp"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Location"
                        android:textColor="@color/rh_text_secondary"
                        android:textSize="15sp"/>
                    <TextView
                        android:id="@+id/location_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/empty_value"
                        android:textColor="@color/rh_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <View android:layout_width="match_parent" 
                    android:layout_height="1dp"
                    android:background="@color/rh_divider" 
                    android:layout_marginHorizontal="16dp"/>

                <!-- Occupation -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">
                    <ImageView
                        android:layout_width="@dimen/icon_profile_row"
                        android:layout_height="@dimen/icon_profile_row"
                        android:src="@drawable/ic_work_outline"
                        app:tint="@color/rh_accent"
                        android:layout_marginEnd="14dp"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Occupation"
                        android:textColor="@color/rh_text_secondary"
                        android:textSize="15sp"/>
                    <TextView
                        android:id="@+id/occupation_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/empty_value"
                        android:textColor="@color/rh_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ═══════ HEALTH METRICS ═══════ -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Health Metrics"
                android:textColor="#666666"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.14" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"

            app:cardBackgroundColor="@color/rh_surface"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- BMI -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">

                    <ImageView
                        android:layout_width="@dimen/icon_profile_row"
                        android:layout_height="@dimen/icon_profile_row"
                        android:src="@drawable/ic_bmi"
                        app:tint="#008b8b"
                        android:layout_marginEnd="14dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="BMI"
                        android:textColor="#CCCCCC"
                        android:textSize="15sp"/>

                    <TextView
                        android:id="@+id/bmi_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="22.5"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#262626"
                    android:layout_marginHorizontal="16dp"/>

                <!-- Weight -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">

                    <ImageView
                        android:layout_width="@dimen/icon_profile_row"
                        android:layout_height="@dimen/icon_profile_row"
                        android:src="@drawable/ic_weight"
                        app:tint="#008b8b"
                        android:layout_marginEnd="14dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Weight"
                        android:textColor="#CCCCCC"
                        android:textSize="15sp"/>

                    <TextView
                        android:id="@+id/weight_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="75 kg"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#262626"
                    android:layout_marginHorizontal="16dp"/>

                <!-- Heart Rate -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">

                    <ImageView
                        android:layout_width="@dimen/icon_profile_row"
                        android:layout_height="@dimen/icon_profile_row"
                        android:src="@drawable/ic_heart"
                        app:tint="#008b8b"
                        android:layout_marginEnd="14dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Resting Heart Rate"
                        android:textColor="#CCCCCC"
                        android:textSize="15sp"/>

                    <TextView
                        android:id="@+id/heart_rate_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="72 bpm"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#262626"
                    android:layout_marginHorizontal="16dp"/>

                <!-- Blood Pressure -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">

                    <ImageView
                        android:layout_width="@dimen/icon_profile_row"
                        android:layout_height="@dimen/icon_profile_row"
                        android:src="@drawable/ic_blood_pressure"
                        app:tint="#008b8b"
                        android:layout_marginEnd="14dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Blood Pressure"
                        android:textColor="#CCCCCC"
                        android:textSize="15sp"/>

                    <TextView
                        android:id="@+id/blood_pressure_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="120/80"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ═══════ FITNESS GOALS ═══════ -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fitness Goals"
                android:textColor="#666666"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.14" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/rh_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Primary Goal -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">

                    <ImageView
                        android:layout_width="@dimen/icon_profile_row"
                        android:layout_height="@dimen/icon_profile_row"
                        android:src="@drawable/ic_lifestyle"
                        app:tint="#008b8b"
                        android:layout_marginEnd="14dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Primary Goal"
                        android:textColor="#CCCCCC"
                        android:textSize="15sp"/>

                    <TextView
                        android:id="@+id/primary_goal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Weight Loss"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#262626"
                    android:layout_marginHorizontal="16dp"/>

                <!-- Weekly Goal -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">

                    <ImageView
                        android:layout_width="@dimen/icon_profile_row"
                        android:layout_height="@dimen/icon_profile_row"
                        android:src="@drawable/ic_date"
                        app:tint="#008b8b"
                        android:layout_marginEnd="14dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Weekly Goal"
                        android:textColor="#CCCCCC"
                        android:textSize="15sp"/>

                    <TextView
                        android:id="@+id/weekly_goal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3 workouts"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#262626"
                    android:layout_marginHorizontal="16dp"/>

                <!-- Exercise Preferences -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">

                    <ImageView
                        android:layout_width="@dimen/icon_profile_row"
                        android:layout_height="@dimen/icon_profile_row"
                        android:src="@drawable/ic_exercise"
                        app:tint="#008b8b"
                        android:layout_marginEnd="14dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Exercise Preferences"
                        android:textColor="#CCCCCC"
                        android:textSize="15sp"/>

                    <TextView
                        android:id="@+id/exercise_preferences"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Running, Yoga"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ═══════ HEALTH & LIFESTYLE ═══════ -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Health &amp; Lifestyle"
                android:textColor="#666666"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.14" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/rh_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Activity Level -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">

                    <ImageView
                        android:layout_width="@dimen/icon_profile_row"
                        android:layout_height="@dimen/icon_profile_row"
                        android:src="@drawable/ic_activity"
                        app:tint="#008b8b"
                        android:layout_marginEnd="14dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Activity Level"
                        android:textColor="#CCCCCC"
                        android:textSize="15sp"/>

                    <TextView
                        android:id="@+id/activity_level"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Moderately Active"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#262626"
                    android:layout_marginHorizontal="16dp"/>

                <!-- Sleep Hours -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">

                    <ImageView
                        android:layout_width="@dimen/icon_profile_row"
                        android:layout_height="@dimen/icon_profile_row"
                        android:src="@drawable/ic_sleep"
                        app:tint="#008b8b"
                        android:layout_marginEnd="14dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sleep Hours"
                        android:textColor="#CCCCCC"
                        android:textSize="15sp"/>

                    <TextView
                        android:id="@+id/sleep_hours"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="7-8 hours"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#262626"
                    android:layout_marginHorizontal="16dp"/>

                <!-- Diet Type -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">

                    <ImageView
