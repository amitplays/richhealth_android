                            app:boxCornerRadiusBottomStart="8dp"
                            app:boxCornerRadiusBottomEnd="8dp"
                            app:boxStrokeWidth="1dp"
                            app:hintTextColor="#008b8b"
                            android:textColorHint="#757575"
                            app:startIconDrawable="@drawable/ic_food"
                            app:startIconTint="#008b8b">

                            <AutoCompleteTextView
                                android:id="@+id/diet_type_input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Diet Type"
                                android:inputType="none"
                                android:textColor="@android:color/white" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Activity Level Info Cards -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#1A1A1A">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:padding="12dp"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="@dimen/icon_md"
                                    android:layout_height="@dimen/icon_md"
                                    android:src="@drawable/ic_plans"
                                    app:tint="#008b8b"
                                    android:layout_marginEnd="12dp" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="We'll customize your workout and nutrition plans based on your lifestyle"
                                    android:textColor="#808080"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </FrameLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/button_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/back_button"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Back"
            android:textColor="#008b8b"
            app:strokeColor="#008b8b"
            app:cornerRadius="8dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/next_button"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#008b8b"
            android:text="Next"
            android:textColor="@android:color/white"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/submit_button"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#008b8b"
            android:text="Create Account"
            android:textColor="@android:color/white"
            app:cornerRadius="8dp"
            android:visibility="gone" />
    </LinearLayout>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="#008b8b"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
</file>

<file path="app/src/main/res/layout/activity_splash.xml">
<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/black">

    <!-- Main Content Container -->
    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Logo with Glow Effect -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <!-- Glow Background -->
            <ImageView
                android:id="@+id/logo_glow"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:alpha="0"
                android:scaleX="1.2"
                android:scaleY="1.2"
                android:src="@drawable/ic_arms"
                android:visibility="visible"
                app:tint="#008b8b" />

            <!-- Main Logo -->
            <ImageView
                android:id="@+id/splash_logo"
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_launcher" />
        </FrameLayout>

        <!-- App Name -->
        <TextView
            android:id="@+id/app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.02"
            android:text="RichHealth"
            android:textColor="#008b8b"
            android:textSize="40sp"
            android:textStyle="bold" />

        <!-- Tagline -->
        <TextView
            android:id="@+id/tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.05"
            android:text="Your Health, Intelligently Rich"
            android:textColor="#CCCCCC"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- Footer -->
    <LinearLayout
        android:id="@+id/footer_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="48dp"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="A product of RichLabs"
            android:textColor="#999999"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=".io"
            android:textColor="#ac5e00"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

</RelativeLayout>
</file>

<file path="app/src/main/res/layout/activity_usage_status.xml">
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/black">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Your Plan"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />

        <!-- Plan badge (inline) -->
        <TextView
            android:id="@+id/plan_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Free Plan"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:background="@drawable/rounded_category_bg"
            android:backgroundTint="#1A1A1A"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp" />
    </LinearLayout>

    <!-- Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ═══════ TOP SECTION (black bg shows through) ═══════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:tag="section_icon"
                        android:src="@drawable/ic_bar_chart_4_bars"
                        app:tint="#008b8b"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/dialog_usage_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your Usage Overview"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/dialog_plan_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Track your limits across chat, reports, and analysis"
                    android:textColor="#999999"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/usage_reset_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#008b8b"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:visibility="gone"
                    android:layout_marginBottom="12dp"
                    tools:text="RESETS IN 12 DAYS" />

                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/usage_overview_pie_chart"
                    android:layout_width="match_parent"
                    android:layout_height="200dp" />

                <TextView
                    android:id="@+id/chart_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Plan allocation overview"
                    android:textColor="#808080"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp" />

            </LinearLayout>

            <!-- ═══════ CARDS CONTAINER (teal_700, rounded top) ═══════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/rounded_top_dark_bg"
                android:padding="16dp">

                <!-- Usage Summary Cards (3 columns): Analysis | Reports | Chat -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp">

                    <!-- Analysis Usage -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#262626">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:padding="12dp">

                            <ImageView
                                android:layout_width="@dimen/icon_sm"
                                android:layout_height="@dimen/icon_sm"
                                android:tag="section_icon"
                                android:src="@drawable/ic_analysis"
                                app:tint="#008b8b"
                                android:layout_marginBottom="8dp" />

                            <TextView
                                android:id="@+id/dialog_usage_analysis_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0/1"
                                android:textColor="@color/white"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="2dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Analysis"
                                android:textColor="#808080"
                                android:textSize="10sp"
                                android:layout_marginBottom="2dp" />

                            <TextView
                                android:id="@+id/dialog_usage_analysis_period"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="monthly"
                                android:textColor="#808080"
                                android:textSize="10sp" />

                            <ProgressBar
                                android:id="@+id/pb_usage_analysis"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="4dp"
                                android:layout_marginTop="8dp"
                                android:max="100"
                                android:progress="0"
                                android:progressTint="#008B8B"
                                android:progressBackgroundTint="#1F1F1F" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Reports Usage -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="3dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#262626">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:padding="12dp">

                            <ImageView
                                android:layout_width="@dimen/icon_sm"
                                android:layout_height="@dimen/icon_sm"
                                android:tag="section_icon"
                                android:src="@drawable/ic_doc"
                                app:tint="#008b8b"
                                android:layout_marginBottom="8dp" />

                            <TextView
                                android:id="@+id/dialog_usage_reports_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0/2"
                                android:textColor="@color/white"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="2dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Reports"
                                android:textColor="#808080"
                                android:textSize="10sp"
                                android:layout_marginBottom="2dp" />

                            <TextView
                                android:id="@+id/dialog_usage_reports_period"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="monthly"
                                android:textColor="#808080"
                                android:textSize="10sp" />

                            <ProgressBar
                                android:id="@+id/pb_usage_reports"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="4dp"
                                android:layout_marginTop="8dp"
                                android:max="100"
                                android:progress="0"
                                android:progressTint="#008B8B"
                                android:progressBackgroundTint="#1F1F1F" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Chat Usage -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#262626">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:padding="12dp">

                            <ImageView
                                android:layout_width="@dimen/icon_sm"
                                android:layout_height="@dimen/icon_sm"
                                android:tag="section_icon"
                                android:src="@drawable/ic_chat"
                                app:tint="#008b8b"
                                android:layout_marginBottom="8dp" />

                            <TextView
                                android:id="@+id/dialog_usage_chat_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="5"
                                android:textColor="@color/white"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="2dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Chat"
                                android:textColor="#808080"
                                android:textSize="10sp"
                                android:layout_marginBottom="2dp" />

                            <TextView
                                android:id="@+id/dialog_usage_chat_period"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="per session"
                                android:textColor="#808080"
                                android:textSize="10sp" />

                            <ProgressBar
                                android:id="@+id/pb_usage_chat"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="4dp"
                                android:layout_marginTop="8dp"
                                android:max="100"
                                android:progress="0"
                                android:progressTint="#008B8B"
                                android:progressBackgroundTint="#1F1F1F" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Usage Summary Row 2: NutriCheck | Diet Guide | Report Analysis -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp">

                    <!-- NutriCheck -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#262626">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:padding="12dp">

                            <ImageView
                                android:layout_width="@dimen/icon_sm"
                                android:layout_height="@dimen/icon_sm"
                                android:tag="section_icon"
                                android:src="@drawable/ic_food"
                                app:tint="#008b8b"
                                android:layout_marginBottom="8dp" />

                            <TextView
                                android:id="@+id/dialog_usage_nutri_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Locked"
                                android:textColor="#FF9800"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="2dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="NutriCheck"
                                android:textColor="#808080"
                                android:textSize="10sp" />

                            <ProgressBar
                                android:id="@+id/pb_usage_nutri"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="4dp"
                                android:layout_marginTop="8dp"
                                android:max="100"
                                android:progress="0"
                                android:progressTint="#008B8B"
                                android:progressBackgroundTint="#1F1F1F" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Diet Guide -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#262626">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:padding="12dp">

                            <ImageView
                                android:layout_width="@dimen/icon_sm"
                                android:layout_height="@dimen/icon_sm"
                                android:tag="section_icon"
                                android:src="@drawable/ic_grocery"
                                app:tint="#008b8b"
                                android:layout_marginBottom="8dp" />

                            <TextView
                                android:id="@+id/dialog_usage_dietary_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="2dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Diet Guide"
                                android:textColor="#808080"
                                android:textSize="10sp" />

                            <ProgressBar
                                android:id="@+id/pb_usage_dietary"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="4dp"
                                android:layout_marginTop="8dp"
                                android:max="100"
                                android:progress="0"
                                android:progressTint="#008B8B"
                                android:progressBackgroundTint="#1F1F1F" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- Plan Tabs -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="4dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="10dp">

                    <ImageView
                        android:layout_width="@dimen/icon_sm"
                        android:layout_height="@dimen/icon_sm"
                        android:tag="section_icon"
                        android:src="@drawable/ic_dashboard_customize"
                        app:tint="#fff"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/dialog_feature_section_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Plan Features"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/plan_tabs_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/pill_tab_container_bg"
                        android:padding="4dp">

                        <TextView
                            android:id="@+id/tab_plan_free"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Free"
                            android:textSize="12sp"
                            android:textColor="#AAAAAA"
                            android:background="@drawable/pill_tab_unselected"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="9dp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/tab_plan_plus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Plus"
                            android:textSize="12sp"
                            android:textColor="#AAAAAA"
                            android:background="@drawable/pill_tab_unselected"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="9dp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/tab_plan_pro"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pro"
                            android:textSize="12sp"
                            android:textColor="#AAAAAA"
                            android:background="@drawable/pill_tab_unselected"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="9dp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/tab_plan_ultra"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ultra"
                            android:textSize="12sp"
                            android:textColor="#AAAAAA"
                            android:background="@drawable/pill_tab_unselected"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="9dp"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Feature Table -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#262626">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Table Header -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="10dp"
                            android:paddingHorizontal="12dp"
                            android:background="#1F1F1F">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.5"
                                android:text="FEATURE"
                                android:textColor="#808080"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08" />

                            <TextView
                                android:id="@+id/dialog_feature_value_header"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="LIMIT"
                                android:textColor="#008b8b"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08"
                                android:gravity="center" />
                        </LinearLayout>

                        <!-- Row 1: Chat / session -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="9dp"
                            android:paddingHorizontal="12dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.5"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="@dimen/icon_xs"
                                    android:layout_height="@dimen/icon_xs"
                                    android:tag="section_icon"
                                    android:src="@drawable/ic_forum"
                                    app:tint="#008b8b"
                                    android:layout_marginEnd="6dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Chat / session"
                                    android:textColor="#CCCCCC"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/feat_val_chat"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="5"
                                android:textColor="#4CAF50"
                                android:textSize="12sp"
                                android:gravity="center" />
                        </LinearLayout>

                        <!-- Row 2: Sessions / month (alt bg) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="9dp"
                            android:paddingHorizontal="12dp"
                            android:background="#2A2A2A">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.5"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="@dimen/icon_xs"
                                    android:layout_height="@dimen/icon_xs"
                                    android:tag="section_icon"
                                    android:src="@drawable/ic_calendar_month"
                                    app:tint="#008b8b"
                                    android:layout_marginEnd="6dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Sessions / month"
                                    android:textColor="#CCCCCC"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/feat_val_sessions"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="5"
                                android:textColor="#4CAF50"
                                android:textSize="12sp"
                                android:gravity="center" />
                        </LinearLayout>

                        <!-- Row 3: Health analysis -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="9dp"
                            android:paddingHorizontal="12dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.5"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="@dimen/icon_xs"
                                    android:layout_height="@dimen/icon_xs"
                                    android:tag="section_icon"
                                    android:src="@drawable/ic_health_metrics"
                                    app:tint="#008b8b"
                                    android:layout_marginEnd="6dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Health analysis"
                                    android:textColor="#CCCCCC"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/feat_val_analysis"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="1/month"
                                android:textColor="#4CAF50"
                                android:textSize="12sp"
                                android:gravity="center" />
                        </LinearLayout>

                        <!-- Row 4: Medical reports (alt bg) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="9dp"
                            android:paddingHorizontal="12dp"
                            android:background="#2A2A2A">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.5"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="@dimen/icon_xs"
                                    android:layout_height="@dimen/icon_xs"
                                    android:tag="section_icon"
                                    android:src="@drawable/ic_lab_profile"
                                    app:tint="#008b8b"
                                    android:layout_marginEnd="6dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Medical reports"
                                    android:textColor="#CCCCCC"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/feat_val_reports"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="2/month"
                                android:textColor="#4CAF50"
                                android:textSize="12sp"
                                android:gravity="center" />
                        </LinearLayout>

                        <!-- Row 5: NutriCheck -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="9dp"
                            android:paddingHorizontal="12dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.5"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="@dimen/icon_xs"
                                    android:layout_height="@dimen/icon_xs"
                                    android:tag="section_icon"
                                    android:src="@drawable/ic_nutrition"
                                    app:tint="#008b8b"
                                    android:layout_marginEnd="6dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="NutriCheck"
                                    android:textColor="#CCCCCC"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/feat_val_nutri"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="--"
                                android:textColor="#4CAF50"
                                android:textSize="12sp"
                                android:gravity="center" />
                        </LinearLayout>

                        <!-- Row 5.5: Dietary Insights (alt bg) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="9dp"
                            android:paddingHorizontal="12dp"
                            android:background="#2A2A2A">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.5"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="@dimen/icon_xs"
                                    android:layout_height="@dimen/icon_xs"
                                    android:tag="section_icon"
                                    android:src="@drawable/ic_grocery"
                                    app:tint="#008b8b"
                                    android:layout_marginEnd="6dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Diet Guide"
                                    android:textColor="#CCCCCC"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/feat_val_dietary"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="--"
                                android:textColor="#4CAF50"
                                android:textSize="12sp"
                                android:gravity="center" />
                        </LinearLayout>

                        <!-- Row 6: Report analysis -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="9dp"
                            android:paddingHorizontal="12dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.5"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="@dimen/icon_xs"
                                    android:layout_height="@dimen/icon_xs"
                                    android:tag="section_icon"
                                    android:src="@drawable/ic_diagnosis"
                                    app:tint="#008b8b"
                                    android:layout_marginEnd="6dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Report analysis"
                                    android:textColor="#CCCCCC"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/feat_val_report_analysis"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="--"
                                android:textColor="#4CAF50"
                                android:textSize="12sp"
                                android:gravity="center" />
                        </LinearLayout>

                        <!-- Row 7: AI model (alt bg) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="9dp"
                            android:paddingHorizontal="12dp"
                            android:background="#2A2A2A">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.5"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="@dimen/icon_xs"
                                    android:layout_height="@dimen/icon_xs"
                                    android:tag="section_icon"
                                    android:src="@drawable/ic_model_training"
                                    app:tint="#008b8b"
                                    android:layout_marginEnd="6dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="AI model"
                                    android:textColor="#CCCCCC"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/feat_val_model"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="All"
                                android:textColor="#4CAF50"
                                android:textSize="12sp"
                                android:gravity="center" />
                        </LinearLayout>

                        <!-- Row 8: Data sharing -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="9dp"
                            android:paddingHorizontal="12dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.5"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="@dimen/icon_xs"
                                    android:layout_height="@dimen/icon_xs"
                                    android:tag="section_icon"
                                    android:src="@drawable/ic_dataset_linked"
                                    app:tint="#008b8b"
                                    android:layout_marginEnd="6dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Data sharing"
                                    android:textColor="#CCCCCC"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/feat_val_sharing"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="--"
                                android:textColor="#4CAF50"
                                android:textSize="12sp"
                                android:gravity="center" />
                        </LinearLayout>

                        <!-- Row 9: Dependents (alt bg) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="9dp"
                            android:paddingHorizontal="12dp"
                            android:background="#2A2A2A">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.5"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="@dimen/icon_xs"
                                    android:layout_height="@dimen/icon_xs"
                                    android:tag="section_icon"
                                    android:src="@drawable/ic_family_group"
                                    app:tint="#008b8b"
                                    android:layout_marginEnd="6dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Dependents"
                                    android:textColor="#CCCCCC"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/feat_val_dependents"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="0"
                                android:textColor="#4CAF50"
                                android:textSize="12sp"
                                android:gravity="center" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Upgrade Button — MaterialButton ignores android:background,
                     so we must use app:backgroundTint for the base color.
                     Java code overrides this for pro users (dark bg + teal outline). -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dialog_usage_upgrade_button"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Upgrade to Pro"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02"
                    app:backgroundTint="#008B8B"
                    app:cornerRadius="12dp" />

            </LinearLayout>
            <!-- end teal container -->

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
</file>

<file path="app/src/main/res/layout/add_workout.xml">
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/black">

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add Workout"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:alpha="1"/>

            <TextView
                android:id="@+id/workout_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter the details to create your workout"
                android:textColor="#808080"
                android:textSize="16sp"
                android:layout_marginTop="4dp"
                android:alpha="1"/>
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Exercise Selection Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#1A1A1A">

                <!-- Exercise Details Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Exercise Details"
                        android:textColor="#008b8b"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                    <!-- Exercise Selection Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/select_exercise_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#262626">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="16dp"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/selected_exercise_text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Select Exercise"
                                android:textColor="@color/white"
                                android:textSize="16sp"/>

                            <ImageView
                                android:layout_width="@dimen/icon_md"
                                android:layout_height="@dimen/icon_md"
                                android:src="@drawable/ic_baseline_add_24"
                                app:tint="#008b8b"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Sets, Reps, Weight Cards -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp">

                        <!-- Sets Card -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#262626">

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@android:color/transparent"
                                app:boxStrokeWidth="0dp"
                                app:boxStrokeWidthFocused="0dp"
                                app:hintEnabled="true">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/sets_input"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Sets"
                                    android:inputType="number"
                                    android:padding="16dp"
                                    android:textColor="@color/white"
                                    android:textColorHint="#808080"/>
                            </com.google.android.material.textfield.TextInputLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Reps Card -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#262626">

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@android:color/transparent"
                                app:boxStrokeWidth="0dp"
                                app:boxStrokeWidthFocused="0dp"
                                app:hintEnabled="true">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/reps_input"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Reps"
                                    android:inputType="number"
                                    android:padding="16dp"
                                    android:textColor="@color/white"
                                    android:textColorHint="#808080"/>
                            </com.google.android.material.textfield.TextInputLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Weight Card -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#262626">

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@android:color/transparent"
                                app:boxStrokeWidth="0dp"
                                app:boxStrokeWidthFocused="0dp"
                                app:hintEnabled="true">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/weight_input"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="kg"
                                    android:inputType="numberDecimal"
                                    android:padding="16dp"
                                    android:textColor="@color/white"
                                    android:textColorHint="#808080"/>
                            </com.google.android.material.textfield.TextInputLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- Add Exercise Button -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/add_exercise"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_gravity="end"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#262626">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="12dp"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="@dimen/icon_md"
                                android:layout_height="@dimen/icon_md"
                                android:src="@drawable/ic_add"
                                app:tint="#008b8b"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Add Exercise"
                                android:textColor="#008b8b"
                                android:textSize="16sp"
                                android:layout_marginStart="8dp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Exercises List -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#1A1A1A">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Added Exercises"
                        android:textColor="#008b8b"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/exercises_recycler"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:clipToPadding="false"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/save_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Workout"
        android:layout_margin="16dp"
        app:cornerRadius="12dp"
        app:backgroundTint="#008b8b"/>

</LinearLayout>
</file>

