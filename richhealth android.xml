<file path="app/src/main/res/drawable/ic_nav_health.xml">
<?xml version="1.0" encoding="utf-8"?>
<!--
    Bottom nav HEALTH HUB icon — StateListDrawable
    Replaces the raster vitals.png with a proper vector asset.
    checked=true  → filled heart + ECG (ic_health_hub)
    default       → outline heart + ECG (ic_health_hub_outline)
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true"  android:drawable="@drawable/ic_health_hub" />
    <item                               android:drawable="@drawable/ic_health_hub_outline" />
</selector>
</file>

<file path="app/src/main/res/drawable/ic_nav_home.xml">
<?xml version="1.0" encoding="utf-8"?>
<!--
    Bottom nav SERVICES icon (id kept as navigation_home for compatibility).
    Uses the Material "apps" grid icon.
    checked=true  → teal  (ic_apps)
    default       → white (ic_apps_outline)
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true"  android:drawable="@drawable/ic_apps" />
    <item                               android:drawable="@drawable/ic_apps_outline" />
</selector>
</file>

<file path="app/src/main/res/drawable/ic_nav_profile.xml">
<?xml version="1.0" encoding="utf-8"?>
<!--
    Bottom nav PROFILE icon — StateListDrawable
    checked=true  → filled person silhouette (ic_person)
    default       → outline person silhouette (ic_person_outline)
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true"  android:drawable="@drawable/ic_person" />
    <item                               android:drawable="@drawable/ic_person_outline" />
</selector>
</file>

<file path="app/src/main/res/drawable/ic_nav_richie.xml">
<?xml version="1.0" encoding="utf-8"?>
<!--
    Bottom nav RICHIE AI icon — uses the actual RichHealth logo (ic_launcher.png).
    The ColorStateList in MainActivity applies teal tint when selected, gray when not.
    Both states use the same logo so the shape is always consistent.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true"  android:drawable="@drawable/ic_launcher" />
    <item                               android:drawable="@drawable/ic_launcher" />
</selector>
</file>

