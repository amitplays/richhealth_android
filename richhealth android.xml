<file path="app/src/main/res/layout/dialog_food_info.xml">
<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="#1A1A1A"
    app:cardElevation="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Dialog Title with Loading Indicator -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/dialog_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Food Information"
                android:textColor="#008b8b"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <!-- Loading Icon (initially visible during loading) -->
            <ImageView
                android:id="@+id/loading_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_launcher"
                android:visibility="visible" />
        </RelativeLayout>

        <!-- Pill Tabs -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/dietary_tabs"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:minHeight="0dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/pill_tab_container_bg"
            android:paddingHorizontal="4dp"
            android:paddingVertical="0dp"
            app:tabBackground="@drawable/tab_pill_selector"
            app:tabIndicator="@null"
            app:tabRippleColor="@android:color/transparent"
            app:tabTextColor="#808080"
            app:tabSelectedTextColor="#FFFFFF"
            app:tabTextAppearance="@style/PillTabText"
            app:tabMinWidth="0dp"
            app:tabGravity="fill"
            app:tabMode="fixed"
            app:tabPaddingStart="0dp"
            app:tabPaddingEnd="0dp"
            app:tabPaddingTop="0dp"
            app:tabPaddingBottom="0dp">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Foods to Eat"/>

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Foods to Avoid"/>
        </com.google.android.material.tabs.TabLayout>

        <!-- Table header -->
        <LinearLayout
            android:id="@+id/dietary_table_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="Food"
                android:textColor="#008b8b"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingEnd="6dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:text="Components"
                android:textColor="#008b8b"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="6dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="Reason"
                android:textColor="#008b8b"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="6dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="8dp"
            android:background="#1F1F1F" />

        <!-- Scrollable food list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/food_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="350dp"
            android:scrollbars="vertical"/>

        <!-- Disclaimer -->
        <TextView
            android:id="@+id/disclaimer_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:text="Disclaimer: This information is general guidance. Always consult with a healthcare professional for personalized nutrition advice."
            android:textColor="#757575"
            android:textSize="11sp"/>

        <!-- OK Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/ok_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OK"
            android:textColor="@android:color/white"
            app:backgroundTint="#008b8b"
            app:cornerRadius="8dp"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
</file>

<file path="app/src/main/res/layout/dialog_forked_chat.xml">
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:paddingHorizontal="14dp"
    android:paddingVertical="14dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#0A0A0A"
        app:strokeColor="#1F3A3A"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp"
                android:paddingBottom="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_call_split"
                    android:layout_marginEnd="10dp"
                    app:tint="#008b8b" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Forked Chat"
                        android:textColor="#E0E0E0"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/forked_chat_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#7A9999"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/forked_chat_close"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_close"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Close"
                    app:tint="#888888" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/forked_chat_open_original"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginHorizontal="18dp"
                android:layout_marginBottom="12dp"
                android:text="Open original chat"
                android:textSize="13sp"
                android:textColor="#008b8b"
                android:textAllCaps="false"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="42dp"
                app:cornerRadius="12dp"
                app:strokeColor="#1F4040"
                app:strokeWidth="1dp"
                app:backgroundTint="#0CFFFFFF"
                app:rippleColor="#20008b8b"
                app:icon="@drawable/ic_arrow_forward_ios"
                app:iconTint="#008b8b"
                app:iconSize="14dp"
                app:iconGravity="textEnd"
                app:iconPadding="6dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="#1A1A1A" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/forked_chat_recycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="240dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="8dp"
                android:clipToPadding="false" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
</file>

<file path="app/src/main/res/layout/dialog_health_analysis.xml">
<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#1A1A1A"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ═══════ HEADER: Title + Plan Badge (same row) ═══════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:layout_width="@dimen/icon_md"
                    android:layout_height="@dimen/icon_md"
                    android:tag="section_icon"
                    android:src="@drawable/ic_stethoscope"
                    app:tint="#008b8b"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Health Analysis"
                    android:textColor="#008b8b"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Plan badge (inline) -->
                <TextView
                    android:id="@+id/dialog_usage_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Free Plan"
                    android:textColor="#808080"
                    android:textSize="11sp"
                    android:background="@drawable/rounded_category_bg"
                    android:backgroundTint="#262626"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp" />
            </LinearLayout>

            <!-- ═══════ AI INSIGHT CARD (THE STAR) ═══════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@android:color/transparent">

                <!-- Gradient Border -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/gradient_border_bg" />

                <!-- Inner Content -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="1dp"
                    app:cardCornerRadius="15dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#262626">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <!-- Status line (mapped to meaningful text) -->
                        <TextView
                            android:id="@+id/dialog_status_line"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="● Health looks stable"
                            android:textColor="#4CAF50"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="10dp" />

                        <!-- AI Headline -->
                        <TextView
                            android:id="@+id/dialog_headline_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Your health metrics are looking great!"
                            android:textColor="@color/white"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:lineSpacingMultiplier="1.3"
                            android:layout_marginBottom="6dp" />

                        <!-- Reason -->
                        <TextView
                            android:id="@+id/dialog_status_reason"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="All essential health data is present"
                            android:textColor="#999999"
                            android:textSize="13sp"
                            android:lineSpacingMultiplier="1.3"
                            android:layout_marginBottom="14dp" />

                        <!-- Bottom row: Refresh button + loading spinner + timestamp -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/dialog_refresh_button"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:text="Refresh"
                                android:textColor="#008b8b"
                                android:textSize="12sp"
                                android:minWidth="0dp"
                                android:paddingHorizontal="0dp"
                                app:icon="@drawable/ic_menu_rotate"
                                app:iconTint="#008b8b"
                                app:iconSize="14dp"
                                app:iconPadding="4dp" />

                            <!-- Loading spinner (shown during refresh) -->
                            <ProgressBar
                                android:id="@+id/dialog_refresh_progress"
                                android:layout_width="@dimen/icon_sm"
                                android:layout_height="@dimen/icon_sm"
                                android:indeterminate="true"
                                android:indeterminateTint="#008b8b"
                                android:visibility="gone" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <TextView
                                android:id="@+id/dialog_last_updated_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#666666"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════ CHANGE NOTIFICATION BANNER ═══════ -->
            <LinearLayout
                android:id="@+id/dialog_change_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_bg_warning"
                android:padding="12dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/dialog_change_banner_text"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Data changed since last analysis"
                    android:textColor="#FF9800"
                    android:textSize="12sp"
                    android:lineSpacingMultiplier="1.2" />

                <TextView
                    android:id="@+id/dialog_change_banner_refresh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Refresh ›"
                    android:textColor="#FF9800"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:paddingStart="12dp" />
            </LinearLayout>

            <!-- ═══════ DETAILED ANALYSIS CARD (title + tabs + content all inside) ═══════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/dialog_analysis_content_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#262626">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Title inside card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="@dimen/icon_sm"
                            android:layout_height="@dimen/icon_sm"
                            android:tag="section_icon"
                            android:src="@drawable/ic_diagnosis"
                            app:tint="#008b8b"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Detailed Analysis"
                            android:textColor="#008b8b"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Pill tabs inside card -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/dialog_analysis_tabs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:background="@drawable/pill_tab_container_bg"
                            android:padding="3dp">

                            <TextView
                                android:id="@+id/tab_reports"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Reports"
                                android:textSize="12sp"
                                android:textColor="#FFFFFF"
                                android:background="@drawable/pill_tab_selected"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="7dp"
                                android:clickable="true"
                                android:focusable="true" />

                            <TextView
                                android:id="@+id/tab_symptoms"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Symptoms"
                                android:textSize="12sp"
                                android:textColor="#AAAAAA"
                                android:background="@drawable/pill_tab_unselected"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="7dp"
                                android:clickable="true"
                                android:focusable="true" />

                            <TextView
                                android:id="@+id/tab_medications"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Medications"
                                android:textSize="12sp"
                                android:textColor="#AAAAAA"
                                android:background="@drawable/pill_tab_unselected"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="7dp"
                                android:clickable="true"
                                android:focusable="true" />

                            <TextView
                                android:id="@+id/tab_measurements"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Measurements"
                                android:textSize="12sp"
                                android:textColor="#AAAAAA"
                                android:background="@drawable/pill_tab_unselected"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="7dp"
                                android:clickable="true"
                                android:focusable="true" />

                            <TextView
                                android:id="@+id/tab_genetics"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Family Health"
                                android:textSize="12sp"
                                android:textColor="#AAAAAA"
                                android:background="@drawable/pill_tab_unselected"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="7dp"
                                android:clickable="true"
                                android:focusable="true" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <!-- Shimmer skeleton placeholder (shown during loading) -->
                    <LinearLayout
                        android:id="@+id/dialog_analysis_shimmer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <View
                            android:layout_width="140dp"
                            android:layout_height="@dimen/icon_xs"
                            android:background="@drawable/shimmer_placeholder_bg"
                            android:layout_marginBottom="12dp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="10dp"
                            android:background="@drawable/shimmer_placeholder_bg"
                            android:layout_marginBottom="8dp" />

                        <View
                            android:layout_width="240dp"
                            android:layout_height="10dp"
                            android:background="@drawable/shimmer_placeholder_bg"
                            android:layout_marginBottom="8dp" />

                        <View
                            android:layout_width="100dp"
                            android:layout_height="12dp"
                            android:background="@drawable/shimmer_placeholder_bg"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="10dp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="10dp"
                            android:background="@drawable/shimmer_placeholder_bg"
                            android:layout_marginBottom="8dp" />

                        <View
                            android:layout_width="200dp"
                            android:layout_height="10dp"
                            android:background="@drawable/shimmer_placeholder_bg"
                            android:layout_marginBottom="8dp" />

                        <View
                            android:layout_width="260dp"
                            android:layout_height="10dp"
                            android:background="@drawable/shimmer_placeholder_bg" />
                    </LinearLayout>

                    <!-- Summary text -->
                    <TextView
                        android:id="@+id/dialog_analysis_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#E0E0E0"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.4"
                        android:visibility="gone" />

                    <!-- Dynamic details container -->
                    <LinearLayout
                        android:id="@+id/dialog_analysis_details_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />

                    <!-- No data / error message -->
                    <TextView
                        android:id="@+id/dialog_analysis_no_data"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#888888"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:padding="20dp"
                        android:text="Tap Refresh Analysis to generate insights"
                        android:visibility="visible" />

                    <!-- Generated timestamp -->
                    <TextView
                        android:id="@+id/dialog_analysis_generated_at"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#555555"
                        android:textSize="11sp"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════ PROFILE SNAPSHOT (stat grid design) ═══════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#262626">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">

                        <ImageView
                            android:layout_width="@dimen/icon_sm"
                            android:layout_height="@dimen/icon_sm"
                            android:tag="section_icon"
                            android:src="@drawable/ic_patient_list"
                            app:tint="#008b8b"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Profile Snapshot"
                            android:textColor="#008b8b"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Row 1: Age · Gender · Blood Type (3 equal cells) -->
                    <LinearLayout
                        android:id="@+id/dialog_stats_row1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <!-- Age cell -->
                        <LinearLayout
                            android:id="@+id/dialog_cell_age"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/profile_pill_bg"
                            android:backgroundTint="#1E1E1E"
                            android:padding="10dp"
                            android:layout_marginEnd="6dp"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/dialog_pill_age"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="33"
                                android:textColor="#80DEEA"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Age"
                                android:textColor="#666666"
                                android:textSize="10sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Gender cell -->
                        <LinearLayout
                            android:id="@+id/dialog_cell_gender"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/profile_pill_bg"
                            android:backgroundTint="#1E1E1E"
                            android:padding="10dp"
                            android:layout_marginEnd="6dp"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/dialog_pill_gender"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Male"
                                android:textColor="#CE93D8"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Gender"
                                android:textColor="#666666"
                                android:textSize="10sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Blood Type cell -->
                        <LinearLayout
                            android:id="@+id/dialog_cell_blood"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/profile_pill_bg"
                            android:backgroundTint="#1E1E1E"
                            android:padding="10dp"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/dialog_pill_blood"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="O-"
                                android:textColor="#EF9A9A"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Blood"
                                android:textColor="#666666"
                                android:textSize="10sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Row 2: Weight · BMI · Sleep (3 equal cells) -->
                    <LinearLayout
                        android:id="@+id/dialog_stats_row2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <!-- Weight cell -->
                        <LinearLayout
                            android:id="@+id/dialog_cell_weight"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/profile_pill_bg"
                            android:backgroundTint="#1E1E1E"
                            android:padding="10dp"
                            android:layout_marginEnd="6dp"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/dialog_pill_weight"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="75 kg"
                                android:textColor="#A5D6A7"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Weight"
                                android:textColor="#666666"
                                android:textSize="10sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- BMI cell -->
                        <LinearLayout
                            android:id="@+id/dialog_cell_bmi"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/profile_pill_bg"
                            android:backgroundTint="#1E1E1E"
                            android:padding="10dp"
                            android:layout_marginEnd="6dp"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/dialog_pill_bmi"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="24.1"
                                android:textColor="#FFF59D"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/dialog_pill_bmi_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="BMI · Normal"
                                android:textColor="#666666"
                                android:textSize="10sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Sleep cell -->
                        <LinearLayout
                            android:id="@+id/dialog_cell_sleep"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/profile_pill_bg"
                            android:backgroundTint="#1E1E1E"
                            android:padding="10dp"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/dialog_pill_sleep"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="7h"
                                android:textColor="#90CAF9"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Avg Sleep"
                                android:textColor="#666666"
                                android:textSize="10sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Medical Data Grid: Row 3 (Conditions · Medications) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <!-- Conditions cell -->
                        <LinearLayout
                            android:id="@+id/dialog_cell_conditions"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/profile_pill_bg"
                            android:backgroundTint="#1E1E1E"
                            android:padding="10dp"
                            android:layout_marginEnd="6dp">

                            <TextView
                                android:id="@+id/dialog_pill_conditions"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="#4CAF50"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/dialog_pill_conditions_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Conditions"
                                android:textColor="#666666"
                                android:textSize="10sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Medications cell -->
                        <LinearLayout
                            android:id="@+id/dialog_cell_medications"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/profile_pill_bg"
                            android:backgroundTint="#1E1E1E"
                            android:padding="10dp">

                            <TextView
                                android:id="@+id/dialog_pill_medications"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="#2196F3"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/dialog_pill_medications_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Medications"
                                android:textColor="#666666"
                                android:textSize="10sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Medical Data Grid: Row 4 (Reports · Family) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <!-- Reports cell -->
                        <LinearLayout
                            android:id="@+id/dialog_cell_reports"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/profile_pill_bg"
                            android:backgroundTint="#1E1E1E"
                            android:padding="10dp"
                            android:layout_marginEnd="6dp">

                            <TextView
                                android:id="@+id/dialog_pill_reports"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="#FF9800"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/dialog_pill_reports_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Reports"
                                android:textColor="#666666"
                                android:textSize="10sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Family cell -->
                        <LinearLayout
                            android:id="@+id/dialog_cell_family"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/profile_pill_bg"
                            android:backgroundTint="#1E1E1E"
                            android:padding="10dp">

                            <TextView
                                android:id="@+id/dialog_pill_family"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="#4CAF50"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/dialog_pill_family_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Family"
                                android:textColor="#666666"
                                android:textSize="10sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Health Score -->
                    <LinearLayout
                        android:id="@+id/dialog_health_score_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="10dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="6dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Health Score"
                                android:textColor="#808080"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/dialog_health_score_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#008b8b"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/dialog_health_score_progress"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:max="100"
                            android:progress="0"
                            android:progressTint="#008b8b"
                            android:progressBackgroundTint="#333333" />
                    </LinearLayout>

                    <!-- Profile completion (conditional) -->
                    <LinearLayout
                        android:id="@+id/dialog_profile_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="6dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Profile"
                                android:textColor="#808080"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/dialog_profile_percent_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#008b8b"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/dialog_profile_progress"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:max="100"
                            android:progress="0"
                            android:progressTint="#008b8b"
                            android:progressBackgroundTint="#333333" />

                        <TextView
                            android:id="@+id/dialog_missing_fields_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#808080"
                            android:textSize="11sp"
                            android:layout_marginTop="6dp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════ AIR QUALITY (redesigned - status on top, location below, analysis) ═══════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/dialog_aqi_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#262626"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <!-- Top row: Status (big) + AQI value badge -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:id="@+id/dialog_aqi_quality"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Moderate"
                            android:textColor="#FFFF00"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/dialog_aqi_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AQI 142"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:background="@drawable/profile_pill_bg"
                            android:backgroundTint="#333333" />
                    </LinearLayout>

                    <!-- Location row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="@dimen/icon_xs"
                            android:layout_height="@dimen/icon_xs"
                            android:tag="section_icon"
                            android:src="@drawable/ic_location"
                            app:tint="#808080"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/dialog_aqi_location"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Location"
                            android:textColor="#AAAAAA"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/dialog_aqi_records"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#808080"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Analysis summary line -->
                    <TextView
                        android:id="@+id/dialog_aqi_analysis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#999999"
                        android:textSize="11sp"
                        android:lineSpacingMultiplier="1.2"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tap for details ›"
                        android:textColor="#008b8b"
                        android:textSize="11sp"
                        android:layout_marginTop="6dp"
                        android:gravity="end" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════ ACTION BUTTONS (Close + Refresh Analysis) ═══════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dialog_close_button"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Close"
                    android:textColor="@color/white"
                    app:backgroundTint="#757575"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dialog_bottom_refresh_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Refresh Analysis"
                    android:textColor="@color/white"
                    app:backgroundTint="#008b8b"
                    app:cornerRadius="8dp" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.core.widget.NestedScrollView>
</file>

<file path="app/src/main/res/layout/dialog_mental_health_chat.xml">
<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    app:cardBackgroundColor="#1A1A1A"
    app:cardCornerRadius="12dp"
    app:cardElevation="5dp">

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:background="#1A1A1A"
        android:orientation="vertical"
        android:padding="5dp"
        app:cornerRadius="8dp">

        <TextView
            android:id="@+id/dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Wellness Chat"
            android:textColor="#008b8b"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dialog_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Chat anonymously with our AI assistant. Your conversation is private and will not be saved."
            android:textColor="@color/white"
            android:textSize="14sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="5dp"
            android:backgroundTint="#262626">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/chat_recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="8dp"
                android:background="@android:color/transparent" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/message_layout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:textColorHint="#757575"
            app:boxBackgroundColor="#262626"
            app:boxCornerRadiusTopStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxStrokeColor="#008b8b"
            app:boxStrokeWidth="1dp"
            app:hintTextColor="#008b8b">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/message_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:hint="Type your message here..."
                android:inputType="textMultiLine"
                android:minLines="2"
                android:textColor="@color/white" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/close_button"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Cancel"
                android:textColor="@color/white"
                app:backgroundTint="#757575"
                app:cornerRadius="8dp" />


            <com.google.android.material.button.MaterialButton
                android:id="@+id/send_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Send"
                android:textColor="@color/white"
                app:backgroundTint="#008b8b"
                app:cornerRadius="8dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
</file>

<file path="app/src/main/res/layout/dialog_nutri_check.xml">
<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="#1A1A1A"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Dialog Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NutriCheck"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <!-- Food Item Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Enter food item (e.g., chocolate, spinach)"
            app:hintTextColor="#808080"
            app:boxStrokeColor="#008b8b"
            android:textColorHint="#808080"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/food_item_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:textColor="@color/white"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Loading Icon -->
        <ImageView
            android:id="@+id/loading_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_launcher"
            android:visibility="gone"
            android:layout_marginBottom="16dp"/>

        <!-- Result Display -->
        <ScrollView
            android:id="@+id/result_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="150dp"
            android:visibility="gone"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:id="@+id/result_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/recommendation_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/reason_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#CCCCCC"
                    android:textSize="14sp"/>
            </LinearLayout>
        </ScrollView>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/cancel_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel"
                android:textColor="#008b8b"
                android:background="?attr/selectableItemBackground"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_marginEnd="16dp"/>

            <Button
                android:id="@+id/check_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Check"
                android:textColor="@color/white"
                app:backgroundTint="#008b8b"
                style="@style/Widget.MaterialComponents.Button"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
</file>

