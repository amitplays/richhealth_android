<file path="app/src/main/res/drawable/upgrade_hero_halo.xml">
<?xml version="1.0" encoding="utf-8"?>
<!-- Soft teal radial halo. Sits behind the launcher icon on the upgrade
     dialog so the brand mark gets a premium glow without using a raster image. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="radial"
        android:gradientRadius="60dp"
        android:centerX="0.5"
        android:centerY="0.5"
        android:startColor="#33008B8B"
        android:centerColor="#1A008B8B"
        android:endColor="#00000000" />
</shape>
</file>

<file path="app/src/main/res/layout/activity_add_dependent.xml">
<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F0F">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="4dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:src="@drawable/ic_back"
                android:tint="#CCCCCC"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/tv_step_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Step 1 of 4"
                android:textColor="#888888"
                android:textSize="13sp" />

        </RelativeLayout>

        <!-- Progress Bar -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:indicatorColor="#008b8b"
            android:progress="25"
            app:trackColor="#2A2A2A"
            app:trackCornerRadius="4dp"
            app:trackThickness="4dp" />

        <!-- Fragment Container -->
        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Continue Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_continue"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="24dp"
            android:text="Continue"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:backgroundTint="#008b8b"
            app:cornerRadius="12dp" />

    </LinearLayout>

    <!-- Loading Overlay -->
    <FrameLayout
        android:id="@+id/loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:indicatorColor="#008b8b" />

    </FrameLayout>

</FrameLayout>
</file>

<file path="app/src/main/res/layout/activity_daily_checkin.xml">
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/black">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:background="@color/black">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Health Check-In"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />

        <TextView
            android:id="@+id/tier_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#008b8b"
            android:textSize="11sp"
            android:background="@drawable/rounded_category_bg"
            android:backgroundTint="#0A2828"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ═══ TOP SECTION: chart on black bg ═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:tag="section_icon"
                        android:src="@drawable/ic_heart_check"
                        app:tint="#008b8b"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your Check-In History"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Personalized health questions based on your profile"
                    android:textColor="#999999"
                    android:textSize="13sp"
                    android:layout_marginBottom="12dp" />

                <!-- Check-in history bar chart -->
                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/checkin_chart"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/checkin_chart_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Complete your first check-in to see history"
                    android:textColor="#808080"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp" />

            </LinearLayout>

            <!-- ═══ DARK CARD CONTAINER (rounded top) ═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/rounded_top_dark_bg"
                android:padding="16dp">

                <!-- Start banner: visible when isDue=true -->
                <LinearLayout
                    android:id="@+id/start_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/rounded_category_bg"
                    android:backgroundTint="#0A2828"
                    android:padding="20dp"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your check-in is ready"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your AI-powered questions are generated just for you based on your health profile."
                        android:textColor="#808080"
                        android:textSize="13sp"
                        android:layout_marginBottom="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_start_checkin"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Start Health Check-In"
                        android:textColor="@color/white"
                        app:backgroundTint="#008b8b"
                        app:cornerRadius="12dp" />

                </LinearLayout>

                <!-- Loading state -->
                <LinearLayout
                    android:id="@+id/list_loading_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingVertical="48dp"
                    android:visibility="visible">

                    <ImageView
                        android:id="@+id/list_loading_logo"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/ic_launcher"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Loading your check-ins..."
                        android:textColor="#808080"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- No access state -->
                <LinearLayout
                    android:id="@+id/no_access_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="48dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_heart_check"
                        app:tint="#008b8b"
                        android:layout_marginBottom="16dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Health Check-In is available on all plans."
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your personalized check-in will be scheduled automatically."
                        android:textColor="#808080"
                        android:textSize="13sp"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Empty state -->
                <LinearLayout
                    android:id="@+id/empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="48dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_success"
                        app:tint="#008b8b"
                        android:layout_marginBottom="16dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="You're all caught up!"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/empty_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your next check-in will appear here when it's ready."
                        android:textColor="#808080"
                        android:textSize="13sp"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Session list — nestedScrollingEnabled=false so it expands fully inside NestedScrollView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/checkin_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingBottom="16dp"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
</file>

