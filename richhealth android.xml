<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#262626">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Top row: Icon, Name, Status chip, action icons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/status_icon"
                android:layout_width="@dimen/icon_md"
                android:layout_height="@dimen/icon_md"
                android:src="@drawable/ic_person"
                app:tint="#008b8b"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/name_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Family Member Name"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/status_chip"
                style="@style/Widget.RH.StatusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONNECTED"
                app:chipBackgroundColor="#4CAF50"/>

            <!-- Edit icon (shown for accepted) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/edit_button"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                app:icon="@drawable/ic_edit"
                app:iconTint="#008b8b"
                app:iconSize="16dp"
                app:iconPadding="0dp"
                app:iconGravity="textStart"
                app:cornerRadius="16dp"
                android:layout_marginStart="2dp"
                android:visibility="gone"/>

            <!-- Remove icon (shown for accepted) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/remove_button"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                app:icon="@drawable/ic_delete"
                app:iconTint="#FF5252"
                app:iconSize="16dp"
                app:iconPadding="0dp"
                app:iconGravity="textStart"
                app:cornerRadius="16dp"
                android:layout_marginStart="2dp"
                android:visibility="gone"/>

            <!-- Cancel request icon (shown for pending) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancel_request_button"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                app:icon="@drawable/ic_close"
                app:iconTint="#FF5252"
                app:iconSize="16dp"
                app:iconPadding="0dp"
                app:iconGravity="textStart"
                app:cornerRadius="16dp"
                android:layout_marginStart="2dp"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- Details rows -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="32dp"
            android:layout_marginTop="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email: "
                android:textColor="#808080"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/email_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="family@example.com"
                android:textColor="#008b8b"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="32dp"
            android:layout_marginTop="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Relation: "
                android:textColor="#808080"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/relationship_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Father"
                android:textColor="#008b8b"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/pro_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRO"
                android:textColor="#FFD700"
                android:textSize="9sp"
                android:textStyle="bold"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/gradient_border_bg"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/covered_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COVERED"
                android:textColor="#4CAF50"
                android:textSize="9sp"
                android:textStyle="bold"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1dp"
                android:layout_marginStart="4dp"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- Pro plan action buttons (family plan owners only) -->
        <LinearLayout
            android:id="@+id/action_buttons_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/add_to_pro_button"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Add to Pro"
                android:textSize="11sp"
                android:textColor="#FFD700"
                app:strokeColor="#FFD700"
                app:strokeWidth="1dp"
                app:cornerRadius="8dp"
                android:visibility="gone"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/remove_from_pro_button"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Remove from Pro"
                android:textSize="11sp"
                android:textColor="#FF9800"
                app:strokeColor="#FF9800"
                app:strokeWidth="1dp"
                app:cornerRadius="8dp"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- Hidden main_actions_row for Java compatibility -->
        <LinearLayout
            android:id="@+id/main_actions_row"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="horizontal"
            android:visibility="gone"/>
    </LinearLayout>

    <TextView
        android:id="@+id/status_text"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"/>
</com.google.android.material.card.MaterialCardView>
</file>

<file path="app/src/main/res/layout/item_feed_card.xml">
<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@null"
    app:rippleColor="@android:color/transparent"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#1A1A1A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top row: type badge + date -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <!-- Type badge (Podcast / Article / News) -->
            <TextView
                android:id="@+id/feed_type_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Podcast"
                android:textColor="#008b8b"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:background="@drawable/pill_tab_unselected" />

            <!-- Category tag -->
            <TextView
                android:id="@+id/feed_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wellness"
                android:textColor="#808080"
                android:textSize="11sp"
                android:layout_marginStart="8dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Pro tag -->
            <TextView
                android:id="@+id/feed_pro_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRO"
                android:textColor="#000"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Title row with icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <ImageView
                android:id="@+id/feed_icon"
                android:layout_width="@dimen/icon_feed_title"
                android:layout_height="@dimen/icon_feed_title"
                android:src="@drawable/ic_podcast"
                app:tint="#008b8b"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/feed_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Description -->
        <TextView
            android:id="@+id/feed_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#808080"
            android:textSize="13sp"
            android:maxLines="3"
            android:ellipsize="end"
            android:layout_marginBottom="10dp" />

        <!-- Bottom row: date + sources + actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/feed_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#666666"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Source links button (podcasts/articles) -->
            <!-- Touch target: 48dp container, icon: icon_feed_action (24dp) -->
            <ImageButton
                android:id="@+id/feed_source_button"
                android:layout_width="@dimen/icon_container_md"
                android:layout_height="@dimen/icon_container_md"
                android:src="@drawable/ic_link"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                app:tint="#008b8b"
                android:layout_marginEnd="2dp"
                android:visibility="gone" />

            <!-- Play button (podcasts only) -->
            <!-- Uses icon_feed_play (32dp) in a 48dp touch target -->
            <ImageButton
                android:id="@+id/feed_play_button"
                android:layout_width="@dimen/icon_container_md"
                android:layout_height="@dimen/icon_container_md"
                android:src="@drawable/ic_play"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                app:tint="#008b8b"
                android:visibility="gone" />

            <!-- Read more arrow (articles/news) -->
            <!-- Dedicated ic_arrow_forward — no more rotation hack on ic_back -->
            <ImageButton
                android:id="@+id/feed_read_button"
                android:layout_width="@dimen/icon_container_md"
                android:layout_height="@dimen/icon_container_md"
                android:src="@drawable/ic_arrow_forward"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                app:tint="#008b8b"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
</file>

