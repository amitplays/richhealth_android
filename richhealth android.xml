                Arrays.asList(
                        new StepConfig.SectionConfig(
                                "How many meals a day?",
                                "Meal frequency shapes blood sugar stability and energy dips through the day.",
                                Arrays.asList(
                                        new SelectableOption("1–2 meals", R.drawable.ic_signup_meals_1, 2),
