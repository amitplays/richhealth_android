        if (dataOnFileSummary != null) {
            dataOnFileSummary.setText("–");
            dataOnFileSummary.setTextColor(Color.parseColor("#808080"));
        }

        // Reset tab labels
        String[] tabNames = {"Reports", "Symptoms", "Medications", "Measurements", "Family Health", "Diagnostics"};
