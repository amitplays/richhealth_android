                // Fallback: tier-based badge
                switch (tier) {
                    case "ultra":
                    case "pro":
                    case "family":
                    case "family_member":
                    case "plus":
                        Utils.PlanBadge.apply(usageBadge, tier, Utils.PlanBadge.Style.COMPACT, " · Unlimited");
