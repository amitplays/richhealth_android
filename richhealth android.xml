package Models;

import java.util.Date;

public class AQIData {
    private int id;
    private long userId;
    private int aqiValue;
    private String status; // Good, Moderate, Unhealthy, etc.
    private Date recordedAt;
    private String serverId;
    private String city;
    private String state;
    private String country;

