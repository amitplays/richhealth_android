<file path="app/src/main/res/layout/dialog_terms_and_conditions.xml">
<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="12dp"
    app:cardBackgroundColor="#1A1A1A"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ── Fixed header ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="16dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_security"
                app:tint="#008b8b"
                android:contentDescription="Security icon"/>

            <TextView
                android:id="@+id/terms_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Terms &amp; Conditions"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Please review before continuing"
                android:textColor="#666666"
                android:textSize="13sp"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#262626"/>

        <!-- ── Scrollable terms ── single scroll, no nesting ── -->
        <ScrollView
            android:id="@+id/terms_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="vertical"
            android:fadeScrollbars="false"
            android:scrollbarThumbVertical="@color/teal_700"
            android:overScrollMode="always">

            <TextView
                android:id="@+id/terms_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:textColor="#BBBBBB"
                android:textSize="13.5sp"
                android:lineSpacingExtra="4dp"
                android:textColorLink="#008b8b"/>
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#262626"/>

        <!-- ── Fixed footer: checkbox + buttons ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="20dp">

            <!-- Checkbox -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/terms_checkbox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:buttonTint="#008b8b"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="I have read and agree to the Terms, Privacy Policy, and Health Disclaimers"
                    android:textColor="#AAAAAA"
                    android:textSize="12.5sp"
                    android:lineSpacingExtra="2dp"/>
            </LinearLayout>

            <!-- Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/decline_button"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Decline"
                    android:textColor="#FF5252"
                    android:textSize="14sp"
                    android:textAllCaps="false"
                    app:backgroundTint="@android:color/transparent"
                    app:rippleColor="#20FF5252" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/accept_button"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1.5"
                    android:layout_marginStart="8dp"
                    android:text="I Accept"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:enabled="false"
                    android:alpha="0.4"
                    app:backgroundTint="#008b8b"
                    app:cornerRadius="12dp"
                    app:rippleColor="#40FFFFFF" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
</file>

<file path="app/src/main/res/layout/dialog_usage_status.xml">
<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#1A1A1A"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header: Icon + Title -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:layout_width="@dimen/icon_md"
                    android:layout_height="@dimen/icon_md"
                    android:tag="section_icon"
                    android:src="@drawable/ic_premium"
                    app:tint="#008b8b"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/dialog_usage_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Free vs Pro"
                    android:textColor="#008b8b"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Plan Status Card (gradient border) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@android:color/transparent">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/gradient_border_bg" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="1dp"
                    app:cardCornerRadius="13dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#262626">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/dialog_plan_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Free Plan"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/dialog_plan_description"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Limited access to features"
                            android:textColor="#999999"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </com.google.android.material.card.MaterialCardView>

            <!-- Usage Summary Cards (3 columns): Analysis | Reports | Chat -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <!-- Analysis Usage -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#262626">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="@dimen/icon_sm"
                            android:layout_height="@dimen/icon_sm"
                            android:tag="section_icon"
                            android:src="@drawable/ic_analysis"
                            app:tint="#008b8b"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/dialog_usage_analysis_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0/1"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="2dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Analysis"
                            android:textColor="#808080"
                            android:textSize="10sp"
                            android:layout_marginBottom="2dp" />

                        <TextView
                            android:id="@+id/dialog_usage_analysis_period"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="monthly"
                            android:textColor="#808080"
                            android:textSize="10sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Reports Usage -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#262626">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="@dimen/icon_sm"
                            android:layout_height="@dimen/icon_sm"
                            android:tag="section_icon"
                            android:src="@drawable/ic_doc"
                            app:tint="#008b8b"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/dialog_usage_reports_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0/2"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="2dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Reports"
                            android:textColor="#808080"
                            android:textSize="10sp"
                            android:layout_marginBottom="2dp" />

                        <TextView
                            android:id="@+id/dialog_usage_reports_period"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="monthly"
                            android:textColor="#808080"
                            android:textSize="10sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Chat Usage -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#262626">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="@dimen/icon_sm"
                            android:layout_height="@dimen/icon_sm"
                            android:tag="section_icon"
                            android:src="@drawable/ic_chat"
                            app:tint="#008b8b"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/dialog_usage_chat_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="2dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chat"
                            android:textColor="#808080"
                            android:textSize="10sp"
                            android:layout_marginBottom="2dp" />

                        <TextView
                            android:id="@+id/dialog_usage_chat_period"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="per session"
                            android:textColor="#808080"
                            android:textSize="10sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Usage Summary Row 2: NutriCheck | Report Analysis -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <!-- NutriCheck -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#262626">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="@dimen/icon_sm"
                            android:layout_height="@dimen/icon_sm"
                            android:tag="section_icon"
                            android:src="@drawable/ic_food"
                            app:tint="#008b8b"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/dialog_usage_nutri_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Locked"
                            android:textColor="#FF9800"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="2dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NutriCheck"
                            android:textColor="#808080"
                            android:textSize="10sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Report Analysis -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#262626">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="@dimen/icon_sm"
                            android:layout_height="@dimen/icon_sm"
                            android:tag="section_icon"
                            android:src="@drawable/ic_doc"
                            app:tint="#008b8b"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/dialog_usage_report_analysis_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Locked"
                            android:textColor="#FF9800"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="2dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Report Analysis"
                            android:textColor="#808080"
                            android:textSize="10sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Feature Comparison Section -->
            <LinearLayout
                android:id="@+id/dialog_feature_comparison_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/dialog_feature_section_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Feature Comparison"
                    android:textColor="#008b8b"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <!-- Table wrapped in card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#262626">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Table Header -->
                        <LinearLayout
                            android:id="@+id/dialog_feature_header_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="10dp"
                            android:paddingHorizontal="12dp"
                            android:background="#1F1F1F">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.5"
                                android:text="FEATURE"
                                android:textColor="#808080"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08" />

                            <TextView
                                android:id="@+id/dialog_feature_col1_header"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="FREE"
                                android:textColor="#808080"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08"
                                android:gravity="center" />

                            <TextView
                                android:id="@+id/dialog_feature_col2_header"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="PRO"
                                android:textColor="#008b8b"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08"
                                android:gravity="center" />
                        </LinearLayout>

                        <!-- Row 1: Chat messages -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="9dp"
                            android:paddingHorizontal="12dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.5"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="@dimen/icon_xs"
                                    android:layout_height="@dimen/icon_xs"
                                    android:tag="section_icon"
                                    android:src="@drawable/ic_forum"
                                    app:tint="#008b8b"
                                    android:layout_marginEnd="6dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Chat / session"
                                    android:textColor="#CCCCCC"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/dialog_feat_chat_free"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="5"
                                android:textColor="#999999"
                                android:textSize="12sp"
                                android:gravity="center" />

                            <TextView
                                android:id="@+id/dialog_feat_chat_pro"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="50"
                                android:textColor="#4CAF50"
                                android:textSize="12sp"
                                android:gravity="center" />
                        </LinearLayout>

                        <!-- Row 2: Health Analysis (alt bg) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="9dp"
                            android:paddingHorizontal="12dp"
                            android:background="#2A2A2A">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.5"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="@dimen/icon_xs"
                                    android:layout_height="@dimen/icon_xs"
                                    android:tag="section_icon"
                                    android:src="@drawable/ic_health_metrics"
                                    app:tint="#008b8b"
                                    android:layout_marginEnd="6dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Health analysis"
                                    android:textColor="#CCCCCC"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/dialog_feat_analysis_free"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="1/month"
                                android:textColor="#999999"
                                android:textSize="12sp"
                                android:gravity="center" />

                            <TextView
                                android:id="@+id/dialog_feat_analysis_pro"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="10/month"
                                android:textColor="#4CAF50"
                                android:textSize="12sp"
                                android:gravity="center" />
                        </LinearLayout>

                        <!-- Row 3: Medical Reports -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="9dp"
                            android:paddingHorizontal="12dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.5"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="@dimen/icon_xs"
                                    android:layout_height="@dimen/icon_xs"
                                    android:tag="section_icon"
                                    android:src="@drawable/ic_lab_profile"
                                    app:tint="#008b8b"
                                    android:layout_marginEnd="6dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Medical reports"
                                    android:textColor="#CCCCCC"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/dialog_feat_reports_free"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="2/month"
                                android:textColor="#999999"
                                android:textSize="12sp"
                                android:gravity="center" />

                            <TextView
                                android:id="@+id/dialog_feat_reports_pro"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="10/month"
                                android:textColor="#4CAF50"
                                android:textSize="12sp"
                                android:gravity="center" />
                        </LinearLayout>

                        <!-- Row 4: NutriCheck (alt bg) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="9dp"
                            android:paddingHorizontal="12dp"
                            android:background="#2A2A2A">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.5"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="@dimen/icon_xs"
                                    android:layout_height="@dimen/icon_xs"
                                    android:tag="section_icon"
                                    android:src="@drawable/ic_nutrition"
                                    app:tint="#008b8b"
                                    android:layout_marginEnd="6dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="NutriCheck"
                                    android:textColor="#CCCCCC"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/dialog_feat_nutri_free"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="5/month"
                                android:textColor="#999999"
                                android:textSize="12sp"
                                android:gravity="center" />

                            <TextView
                                android:id="@+id/dialog_feat_nutri_pro"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Unlimited"
                                android:textColor="#4CAF50"
                                android:textSize="12sp"
                                android:gravity="center" />
                        </LinearLayout>

                        <!-- Row 5: Report Analysis -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="9dp"
                            android:paddingHorizontal="12dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.5"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="@dimen/icon_xs"
                                    android:layout_height="@dimen/icon_xs"
                                    android:tag="section_icon"
                                    android:src="@drawable/ic_diagnosis"
                                    app:tint="#008b8b"
                                    android:layout_marginEnd="6dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Report analysis"
                                    android:textColor="#CCCCCC"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/dialog_feat_report_analysis_free"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="--"
                                android:textColor="#FF9800"
                                android:textSize="12sp"
                                android:gravity="center" />

                            <TextView
                                android:id="@+id/dialog_feat_report_analysis_pro"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Yes"
                                android:textColor="#4CAF50"
                                android:textSize="12sp"
                                android:gravity="center" />
                        </LinearLayout>

                        <!-- Row 6: AI Models (alt bg) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="9dp"
                            android:paddingHorizontal="12dp"
                            android:background="#2A2A2A">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.5"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="@dimen/icon_xs"
                                    android:layout_height="@dimen/icon_xs"
                                    android:tag="section_icon"
                                    android:src="@drawable/ic_model_training"
                                    app:tint="#008b8b"
                                    android:layout_marginEnd="6dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="AI model"
                                    android:textColor="#CCCCCC"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/dialog_feat_model_free"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Basic"
                                android:textColor="#999999"
                                android:textSize="12sp"
                                android:gravity="center" />

                            <TextView
                                android:id="@+id/dialog_feat_model_pro"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="All"
                                android:textColor="#4CAF50"
                                android:textSize="12sp"
                                android:gravity="center" />
                        </LinearLayout>

                        <!-- Row 7: Data Sharing -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="9dp"
                            android:paddingHorizontal="12dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.5"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="@dimen/icon_xs"
                                    android:layout_height="@dimen/icon_xs"
                                    android:tag="section_icon"
                                    android:src="@drawable/ic_dataset_linked"
                                    app:tint="#008b8b"
                                    android:layout_marginEnd="6dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Data sharing"
                                    android:textColor="#CCCCCC"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/dialog_feat_sharing_free"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="--"
                                android:textColor="#FF9800"
                                android:textSize="12sp"
                                android:gravity="center" />

                            <TextView
                                android:id="@+id/dialog_feat_sharing_pro"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Yes"
                                android:textColor="#4CAF50"
                                android:textSize="12sp"
                                android:gravity="center" />
                        </LinearLayout>

                        <!-- Row 8: Dependents (alt bg) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="9dp"
                            android:paddingHorizontal="12dp"
                            android:background="#2A2A2A">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.5"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="@dimen/icon_xs"
                                    android:layout_height="@dimen/icon_xs"
                                    android:tag="section_icon"
                                    android:src="@drawable/ic_family_group"
                                    app:tint="#008b8b"
                                    android:layout_marginEnd="6dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Dependents"
                                    android:textColor="#CCCCCC"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/dialog_feat_dependents_free"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="0"
                                android:textColor="#FF9800"
                                android:textSize="12sp"
                                android:gravity="center" />

                            <TextView
                                android:id="@+id/dialog_feat_dependents_pro"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="2"
                                android:textColor="#4CAF50"
                                android:textSize="12sp"
                                android:gravity="center" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dialog_usage_cancel_button"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Close"
                    android:textColor="@color/white"
                    app:backgroundTint="#757575"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dialog_usage_upgrade_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upgrade to Pro"
                    android:textColor="@color/white"
                    app:backgroundTint="#008b8b"
                    app:cornerRadius="8dp" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.core.widget.NestedScrollView>
</file>

