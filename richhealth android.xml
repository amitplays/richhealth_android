                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:src="@drawable/ic_podcast_add"
                            app:tint="#008b8b"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Custom Podcast"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginStart="12dp"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Request a podcast on any health or fitness topic, tailored to your specific needs and interests."
                        android:textColor="#B3FFFFFF"
                        android:textSize="14sp"
                        android:layout_marginBottom="12dp"/>

                    <Button
                        android:id="@+id/request_podcast_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Request Custom Podcast"
                        android:textColor="@color/white"
                        app:backgroundTint="#008b8b"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Premium Podcasts Feature -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#2A2A2A">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:src="@drawable/ic_next"
                            app:tint="#008b8b"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Premium Podcasts"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginStart="12dp"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Access our exclusive library of premium health and fitness podcasts with in-depth research and expert analysis."
                        android:textColor="#B3FFFFFF"
                        android:textSize="14sp"
                        android:layout_marginBottom="12dp"/>

                    <Button
                        android:id="@+id/browse_premium_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Browse Premium Podcasts"
                        android:textColor="@color/white"
                        app:backgroundTint="#008b8b"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Advanced Podcast Controls -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#2A2A2A">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
