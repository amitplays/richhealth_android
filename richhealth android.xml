                            android:layout_marginStart="6dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:contentDescription="About Medications"
                            android:focusable="true"
                            android:padding="6dp"
                            android:src="@drawable/ic_info_outline"
                            app:tint="#B5B5B5" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Active prescriptions, dosage and history"
                        android:textColor="#9A9A9A"
                        android:textSize="12.5sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/medications_button"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:text=""
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    app:icon="@drawable/ic_plus_thin"
                    app:iconSize="18dp"
                    app:iconTint="#008b8b"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:cornerRadius="22dp"
                    app:backgroundTint="#26008b8b"
                    app:rippleColor="#40008b8b"
                    app:strokeWidth="0.5dp"
                    app:strokeColor="#4D008b8b" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ─── Family Health Card ─── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/add_relative_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#0CFFFFFF">

            <LinearLayout
