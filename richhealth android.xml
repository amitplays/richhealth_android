    /** Read user health data counts from cache and display what Richie already knows */
    private void populateHealthDataContext() {
        if (healthDataContext == null || hintBox == null) return;
        try {
            android.content.SharedPreferences prefs =
                    requireContext().getSharedPreferences("user_analysis_cache", android.content.Context.MODE_PRIVATE);
            String raw = prefs.getString("analysis_data", null);
            if (raw == null) {
                healthDataContext.setVisibility(View.GONE);
                hintBox.setVisibility(View.VISIBLE);
                return;
            }
            JSONObject cache = new JSONObject(raw);
            JSONObject analysis = cache.optJSONObject("analysis");
            if (analysis == null) {
                healthDataContext.setVisibility(View.GONE);
                hintBox.setVisibility(View.VISIBLE);
                return;
            }
            JSONObject dataPoints = analysis.optJSONObject("dataPoints");
            if (dataPoints == null) {
                healthDataContext.setVisibility(View.GONE);
                hintBox.setVisibility(View.VISIBLE);
                return;
            }
            int reports = dataPoints.optInt("reports", 0);
            int meds = dataPoints.optInt("medications", 0);
            int symptoms = dataPoints.optInt("symptoms", 0);
            int measurements = dataPoints.optInt("measurements", 0);

            if (reports + meds + symptoms + measurements == 0) {
                healthDataContext.setVisibility(View.GONE);
                hintBox.setVisibility(View.VISIBLE);
                return;
            }

            // Build "Richie knows: 2 Reports · 3 Medications · 5 Symptoms · 8 Measurements"
            java.util.List<String> parts = new java.util.ArrayList<>();
            if (reports > 0) parts.add(reports + " report" + (reports > 1 ? "s" : ""));
            if (meds > 0)     parts.add(meds + " med" + (meds > 1 ? "s" : ""));
            if (symptoms > 0) parts.add(symptoms + " symptom" + (symptoms > 1 ? "s" : ""));
            if (measurements > 0) parts.add(measurements + " reading" + (measurements > 1 ? "s" : ""));

            healthDataContext.setText("Richie knows: " + android.text.TextUtils.join(" · ", parts));
            healthDataContext.setVisibility(View.VISIBLE);
            hintBox.setVisibility(View.GONE); // hide generic hint when data exists
        } catch (Exception e) {
            Log.w(TAG, "populateHealthDataContext: " + e.getMessage());
            healthDataContext.setVisibility(View.GONE);
            hintBox.setVisibility(View.VISIBLE);
        }
    }

