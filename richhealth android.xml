<file path="app/src/main/res/layout/layout_chat_limit_dialog.xml">
<?xml version="1.0" encoding="utf-8"?>
<!--
    Chat limit reached dialog — follows the same card style as layout_simple_progress.xml:
    dark #1A1A1A card, spinning/static RichHealth logo, teal accent, white text.
    Used for both per-session message limits and monthly session limits.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        app:cardBackgroundColor="#1A1A1A"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <!-- RichHealth logo — same 56dp as layout_simple_progress -->
            <ImageView
                android:id="@+id/limit_logo"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_launcher"
                android:layout_marginBottom="16dp"/>

            <!-- Title -->
            <TextView
                android:id="@+id/limit_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Session Limit Reached"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="4dp"/>

            <!-- Plan badge — e.g. "Free Plan · 5 messages" -->
            <TextView
                android:id="@+id/limit_plan_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Free Plan"
                android:textColor="#008b8b"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginBottom="16dp"/>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="#2A2A2A"
                android:layout_marginBottom="16dp"/>

            <!-- What happened -->
            <TextView
                android:id="@+id/limit_what_happened"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="You've used all messages in this chat session."
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="16dp"/>

            <!-- Upgrade benefits block -->
            <LinearLayout
                android:id="@+id/limit_upgrade_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#111111"
                android:padding="12dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upgrade to unlock:"
                    android:textColor="#808080"
                    android:textSize="11sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/limit_benefit_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="↑  50 messages per session (Pro)"
                    android:textColor="#BBBBBB"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/limit_benefit_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="↑  20 chat sessions per month (Pro)"
                    android:textColor="#BBBBBB"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/limit_benefit_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="↑  Advanced AI models (Pro)"
                    android:textColor="#BBBBBB"
                    android:textSize="13sp"/>

            </LinearLayout>

            <!-- Reset date -->
            <TextView
                android:id="@+id/limit_reset_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your limit resets on: 1 Jan 2026"
                android:textColor="#555555"
                android:textSize="12sp"
                android:layout_marginBottom="20dp"/>

            <!-- Buttons row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/limit_dismiss_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Not Now"
                    android:textColor="#666666"
                    android:layout_marginEnd="8dp"
                    app:strokeColor="#333333"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/limit_upgrade_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Upgrade"
                    android:textColor="@color/white"
                    android:layout_marginStart="8dp"
                    app:backgroundTint="#008b8b"/>

            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</ScrollView>
</file>

<file path="app/src/main/res/layout/layout_chat_side_panel.xml">
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A1A"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Chat History"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/close_panel_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#808080"
            android:contentDescription="Close panel" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your previous conversations"
        android:textColor="#808080"
        android:textSize="13sp"
        android:paddingHorizontal="12dp"
        android:paddingBottom="8dp" />

    <!-- Content -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_chat"
                app:tint="#008b8b"
                android:alpha="0.4"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No chat history yet"
                android:textColor="#808080"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your chat sessions will appear here"
                android:textColor="#666666"
                android:textSize="12sp"
                android:textAlignment="center" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chat_sessions_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="4dp" />
    </FrameLayout>

    <!-- Bottom action buttons (hidden — functionality kept in Java) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="0dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/delete_all_chats_button"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Delete All"
            android:textSize="12sp"
            android:textColor="#FF5252"
            app:cornerRadius="8dp"
            app:strokeColor="#FF5252"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/new_chat_button"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="New Chat"
            android:textSize="12sp"
